# Cloudflare Pages headers: one block per pattern (a second "/*" would replace
# the first one's headers entirely). No content hashing here, so everything is
# revalidated: a new deploy must never pair new HTML with a cached old script
# (that is what broke the language toggle in a normal Brave session).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; media-src 'self'; frame-ancestors 'none'
  Cache-Control: no-cache
