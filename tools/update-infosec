#!/usr/bin/env python3
"""Research, verify, commit, push and deploy Infosec Briefing on minipc."""
from __future__ import annotations

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
from urllib.request import Request, urlopen
from urllib.parse import urlsplit
import uuid

HERE = Path(__file__).resolve().parent
DEFAULT_REPO = 'https://github.com/yomiplush/2026-world-is-a-fuck-incident.git'
DEFAULT_SITE = 'https://www.infosec-briefing.net/'
PROTECTED = ('tools/update-infosec', 'tools/update-infosec-browser.cjs',
             'prompts/update-infosec', 'tests/update_infosec_test.py', '.github/', '.gitmodules')


class UpdateError(Exception):
    pass


def say(message):
    print(f'[update-infosec] {message}', flush=True)


def run(argv, *, cwd=None, env=None, capture=False, timeout=10800, stdin=None):
    say('実行: ' + ' '.join(map(str, argv)))
    process = None
    try:
        process = subprocess.Popen(list(map(str, argv)), cwd=cwd, env=env, text=True,
                                   stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                                   stdout=subprocess.PIPE if capture else None,
                                   stderr=subprocess.PIPE if capture else None,
                                   start_new_session=True)
        stdout, stderr = process.communicate(input=stdin, timeout=timeout)
    except BaseException as exc:
        if process is not None:
            # Descendants share this session's process group. Tear all of them down
            # before releasing the publication lock, including on Ctrl-C.
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(process.pid, sig)
                except ProcessLookupError:
                    pass
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    pass
            process.communicate()
        if isinstance(exc, (KeyboardInterrupt, SystemExit)):
            raise
        raise UpdateError(f'コマンド実行失敗: {argv[0]}: {exc}') from exc
    if process.returncode:
        if capture:
            print(stdout, end='')
            print(stderr, end='', file=sys.stderr)
        raise UpdateError(f'終了コード {process.returncode}: {argv[0]}。公開処理を停止しました。')
    return stdout.strip() if capture else ''


def git(repo, *args):
    return run(['git', '-C', repo, *args], capture=True, timeout=180)


def read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (ValueError, OSError) as exc:
        raise UpdateError(f'JSONを読めません: {path}: {exc}') from exc


def save_json(path, value):
    path = Path(path)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    temporary.replace(path)


def sha256(path):
    with Path(path).open('rb') as handle:
        return hashlib.file_digest(handle, 'sha256').hexdigest()


def timestamp(value):
    try:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
        if result.tzinfo is None:
            raise ValueError('timezone missing')
        return result
    except (ValueError, TypeError, AttributeError) as exc:
        raise UpdateError(f'基準時刻が不正です: {value}') from exc


def safe_path(root, relative):
    root = Path(root).resolve()
    candidate = root / relative
    if Path(relative).is_absolute() or not candidate.resolve().is_relative_to(root):
        raise UpdateError(f'作業フォルダ外のパス: {relative}')
    # Even an internal symlink can later be changed to point outside the release.
    if any(p.is_symlink() for p in [candidate, *candidate.parents] if p != root):
        raise UpdateError(f'シンボリックリンクは使用できません: {relative}')
    return candidate


@contextmanager
def lock(state):
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'update.lock').open('a+') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise UpdateError('別の update-infosec が実行中です。') from exc
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def config():
    home = Path.home()
    file = Path(os.environ.get('UPDATE_INFOSEC_CONFIG', home / '.config/update-infosec/config.json'))
    supplied = read_json(file) if file.exists() else {}
    runtime = home / '.local/opt/infosec-runtime/node_modules'
    result = dict(repo_url=DEFAULT_REPO, branch='main', site_url=DEFAULT_SITE,
                  project='2026-incident-briefing', state_dir=str(home / '.local/state/update-infosec'),
                  codex=str(runtime / '.bin/codex'), wrangler=str(runtime / '.bin/wrangler'),
                  node_modules=str(runtime), browser='', agent_timeout=10800)
    result.update(supplied)
    if result['repo_url'] != DEFAULT_REPO or result['branch'] != 'main' or result['site_url'] != DEFAULT_SITE:
        raise UpdateError('このコマンドの公開先は既存リポジトリ main / www.infosec-briefing.net 固定です。')
    return result


def browser_env(cfg):
    env = os.environ.copy()
    env['NODE_PATH'] = cfg['node_modules']
    env['INFOSEC_BROWSER'] = cfg['browser']
    return env


def agent_command(cfg, repo, run_dir):
    # Official reviewed-approval mode retains workspace-write. Ubuntu's AppArmor
    # can reject user namespaces; approved retries then use the exec tool's
    # escalation path, rather than disabling the sandbox or changing OS policy.
    args = [cfg['codex'], '--search', 'exec', '--approve-for-me',
            '-c', 'sandbox_workspace_write.network_access=true', '-C', str(repo),
            '--output-schema', str(HERE.parent/'prompts/update-infosec/result.schema.json'),
            '-o', str(run_dir/'research.json')]
    if cfg.get('model'):
        args += ['--model', cfg['model']]
    return args


def doctor(cfg, *, production=True):
    for binary in ('git', 'node', 'npm', 'python3', cfg['codex'], cfg['wrangler']):
        if not shutil.which(binary):
            raise UpdateError(f'必要なコマンドがありません: {binary}')
    if not Path(cfg['browser']).is_file():
        raise UpdateError('config.json の browser に Chrome 実行ファイルを指定してください。')
    run([cfg['codex'], 'login', 'status'], capture=True, timeout=30)
    run(['node', '-e', "require('playwright'); console.log('browser library OK')"],
        env=browser_env(cfg), timeout=30)
    git(Path.cwd(), 'ls-remote', '--exit-code', cfg['repo_url'], 'refs/heads/main')
    for key in ('user.name', 'user.email'):
        run(['git', 'config', '--get', key], capture=True, timeout=30)
    if production:
        # whoami exits 0 even when logged out; listing the actual project tests permissions.
        output = run([cfg['wrangler'], 'pages', 'project', 'list', '--json'],
                     capture=True, timeout=90)
        try:
            projects = json.loads(output)
        except ValueError as exc:
            raise UpdateError('Cloudflare 認証／プロジェクト一覧の確認に失敗しました。wrangler login を実行してください。') from exc
        if not any(p.get('name') == cfg['project'] for p in projects):
            raise UpdateError('Cloudflare の本番プロジェクトへのアクセス権がありません。wrangler login を確認してください。')
    say('事前確認 OK' + ('（本番アクセスを含む）' if production else '（公開認証は未確認）'))


def validate_research(repo, run_id, result, previous_cutoff):
    if result.get('status') != 'ready' or not result.get('summary') or not result.get('motion'):
        raise UpdateError('調査が完了していません。status=ready と要約・motion判断が必要です。')
    if result.get('snapshot_dir') != f'data/{run_id}':
        raise UpdateError('今回専用のスナップショットがありません。')
    snapshot = safe_path(repo, result['snapshot_dir'])
    latest = read_json(repo/'data/latest.json')
    if timestamp(latest['cutoff']) <= timestamp(previous_cutoff):
        raise UpdateError('基準時刻が前回から進んでいません。')
    if timestamp(latest['cutoff']) > datetime.now(timezone.utc):
        raise UpdateError('基準時刻が未来です。')
    if latest.get('incident_register') != f'{run_id}/incident-register.json':
        raise UpdateError('latest.json が今回の調査台帳を参照していません。')
    evidence = read_json(snapshot/'update-infosec-evidence.json')
    if not isinstance(evidence.get('failures'), list) or not evidence.get('sources'):
        raise UpdateError('取得原本と失敗一覧が必要です。')
    saved = set()
    for source in evidence['sources']:
        if not source.get('url', '').startswith('https://'):
            raise UpdateError('取得元は HTTPS URL が必要です。')
        timestamp(source.get('fetched_at'))
        raw = safe_path(repo, source['path'])
        if not raw.is_file() or sha256(raw) != source.get('sha256'):
            raise UpdateError(f'SHA-256 不一致: {source["path"]}')
        if source.get('status') == 200:
            saved.add(source['url'])
    register = read_json(snapshot/'incident-register.json')
    if register.get('cutoff') != latest['cutoff'] or not register.get('records'):
        raise UpdateError('調査台帳の基準時刻／レコードが不正です。')
    impact = read_json(repo/'site/data/impact.json')
    if impact.get('cutoff') != latest['cutoff'] or not impact.get('records'):
        raise UpdateError('現実への影響データが更新されていません。')
    for rows, keys in ((register['records'], ('id', 'title', 'body', 'action', 'sources')),
                       (impact['records'], ('id', 'confirmed', 'unknown', 'response', 'sources'))):
        ids = set()
        for row in rows:
            if any(not row.get(k) for k in keys) or row['id'] in ids:
                raise UpdateError('レコードの必須項目不足／ID重複です。')
            ids.add(row['id'])
            for source in row['sources']:
                if source.get('url') not in saved:
                    raise UpdateError(f'未保存の出典があります: {source.get("url")}')
    report = safe_path(repo, result.get('report_path', ''))
    url = urlsplit(latest['site_report'])
    expected = 'site/' + url.path.lstrip('/').removesuffix('.html') + '.html'
    if url.netloc != 'www.infosec-briefing.net' or result['report_path'] != expected or not report.is_file():
        raise UpdateError('最新レポートのパスが一致しません。')
    return latest


def changed_files(repo):
    tracked = subprocess.check_output(['git', '-C', str(repo), 'diff', '--name-only', '-z', 'HEAD'])
    untracked = subprocess.check_output(['git', '-C', str(repo), 'ls-files', '--others', '--exclude-standard', '-z'])
    return sorted(set(p.decode() for p in (tracked + untracked).split(b'\0') if p))


def check_changes(repo, base):
    if git(repo, 'rev-parse', 'HEAD') != base:
        raise UpdateError('調査エージェントがGit履歴を変更しました。')
    for name in changed_files(repo):
        if not name.startswith(('data/', 'content/', 'docs/', 'site/', 'tools/', 'tests/')) or name.startswith(PROTECTED):
            raise UpdateError(f'更新対象外のファイル: {name}')
        safe_path(repo, name)
    if git(repo, 'diff', '--cached', '--name-only'):
        raise UpdateError('調査エージェントがステージ操作を行いました。')


def release_hashes(repo, names):
    return {name: sha256(safe_path(repo, name)) for name in names if safe_path(repo, name).is_file()}


def verify_release(repo, commit, hashes):
    if git(repo, 'rev-parse', 'HEAD') != commit or git(repo, 'status', '--porcelain'):
        raise UpdateError('検証済みコミットの作業ツリーが変更されています。')
    for name, expected in hashes.items():
        file = safe_path(repo, name)
        if not file.is_file() or sha256(file) != expected:
            raise UpdateError(f'検証済みファイルが変更されています: {name}')
    if (repo/'site').is_dir():
        files = list((repo/'site').rglob('*'))
        if any(p.is_symlink() for p in files):
            raise UpdateError('公開フォルダにシンボリックリンクが追加されました。')
        actual = release_hashes(repo, [str(p.relative_to(repo)) for p in files if p.is_file()])
        expected = {name: digest for name, digest in hashes.items() if name.startswith('site/')}
        if actual != expected:
            raise UpdateError('公開フォルダのファイル一覧が検証時から変わっています。')


def check_retry(repo, record, remote_url):
    if record['stage'] not in ('committed', 'pushed', 'deploying', 'deployed-awaiting-verification', 'complete') or record.get('dry_run'):
        raise UpdateError('commit 済み・検証済みの実行だけ再公開できます。')
    remote = git(repo, 'ls-remote', '--exit-code', remote_url, 'refs/heads/main').split()[0]
    if remote != record['commit']:
        raise UpdateError('GitHub main が検証済みコミットと異なります。Push失敗時は保存されたrepoを確認してください。')


def checks(repo, cfg, run_dir):
    run(['npm', 'ci', '--ignore-scripts'], cwd=repo)
    run(['npm', 'run', 'build'], cwd=repo)
    run(['npm', 'run', 'check:assets'], cwd=repo)
    node_tests = sorted(str(p.relative_to(repo)) for p in (repo/'tests').glob('*.test.cjs'))
    run(['node', '--test', *node_tests], cwd=repo)
    run(['python3', '-m', 'unittest', 'discover', '-s', 'tests', '-p', '*test.py'], cwd=repo)
    env = browser_env(cfg)
    env['INFOSEC_SCREENSHOTS'] = str(run_dir/'screenshots')
    run(['node', HERE/'update-infosec-browser.cjs', repo], cwd=repo, env=env, timeout=300)


def deploy(cfg, repo, record, record_path):
    commit = record['commit']
    verify_release(repo, commit, record['hashes'])
    remote = git(repo, 'ls-remote', '--exit-code', cfg['repo_url'], 'refs/heads/main').split()[0]
    if remote != commit:
        raise UpdateError('GitHub main が検証済みコミットと異なるためデプロイを停止しました。')
    record['stage'] = 'deploying'
    save_json(record_path, record)
    run([cfg['wrangler'], 'pages', 'deploy', 'site', '--project-name', cfg['project'],
         '--branch', 'main', '--commit-hash', commit, '--commit-dirty=false'], cwd=repo, timeout=600)
    record['stage'] = 'deployed-awaiting-verification'
    save_json(record_path, record)
    # Verify content, not just HTTP 200; CDN propagation is bounded to three minutes.
    paths = ['site/index.html', 'site/data/latest.json', 'site/data/impact.json',
             record['result']['report_path']]
    for attempt in range(19):
        pending = []
        for path in paths:
            relative = path.removeprefix('site/')
            url = cfg['site_url'] + relative + '?update-infosec=' + commit
            try:
                with urlopen(Request(url, headers={'Cache-Control': 'no-cache', 'User-Agent': 'update-infosec/1'}), timeout=20) as response:
                    digest = hashlib.sha256(response.read()).hexdigest()
                if digest != record['hashes'].get(path):
                    pending.append(relative)
            except OSError:
                pending.append(relative)
        if not pending:
            break
        if attempt == 18:
            raise UpdateError('デプロイ後の本番内容が一致しません: ' + ', '.join(pending))
        time.sleep(10)
    record['stage'] = 'complete'
    record['completed_at'] = datetime.now(timezone.utc).isoformat()
    save_json(record_path, record)
    say(f'本番公開・内容一致確認 OK: {cfg["site_url"]} / commit {commit}')


def execute(cfg, dry_run):
    doctor(cfg, production=not dry_run)
    run_id = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:6]
    run_dir = Path(cfg['state_dir'])/'runs'/run_id
    run_dir.mkdir(parents=True)
    repo = run_dir/'repo'
    record_path = run_dir/'run.json'
    record = dict(run_id=run_id, stage='starting', dry_run=dry_run)
    save_json(record_path, record)
    # Logs can contain vendor text; store privately, never under the published checkout.
    with (run_dir/'run.log').open('a', buffering=1) as log:
        tee = subprocess.Popen(['tee', '-a', str(run_dir/'run.log')], stdin=subprocess.PIPE, start_new_session=True)
        saved_stdout, saved_stderr = os.dup(1), os.dup(2)
        os.dup2(tee.stdin.fileno(), 1)
        os.dup2(tee.stdin.fileno(), 2)
        try:
            say(f'実行ID: {run_id} / ログ: {run_dir}/run.log')
            run(['git', 'clone', '--single-branch', '--branch', 'main', cfg['repo_url'], repo])
            base = git(repo, 'rev-parse', 'HEAD')
            previous = read_json(repo/'data/latest.json')['cutoff']
            record.update(base=base, stage='researching')
            save_json(record_path, record)
            prompt = (HERE.parent/'prompts/update-infosec/task.ja.md').read_text()
            prompt += f'\n今回の実行ID: {run_id}\n調査開始UTC: {datetime.now(timezone.utc).isoformat()}\n前回基準: {previous}\n'
            args = agent_command(cfg, repo, run_dir)
            run([*args, '-'], cwd=repo, stdin=prompt, timeout=cfg['agent_timeout'])
            result = read_json(run_dir/'research.json')
            check_changes(repo, base)
            validate_research(repo, run_id, result, previous)
            record.update(stage='checking', result=result)
            save_json(record_path, record)
            checks(repo, cfg, run_dir)
            check_changes(repo, base)
            validate_research(repo, run_id, result, previous)
            names = changed_files(repo)
            if not names:
                raise UpdateError('新しい調査結果がありません。')
            if git(repo, 'ls-files', '--others', '--ignored', '--exclude-standard', 'site/'):
                raise UpdateError('公開フォルダにGit管理対象外のファイルがあります。')
            record.update(stage='verified', hashes=release_hashes(repo, [
                str(p.relative_to(repo)) for p in (repo/'site').rglob('*') if p.is_file()]))
            save_json(record_path, record)
            if dry_run:
                say(f'プレビュー検証完了（commit/push/deployなし）: {repo}')
                return
            run(['git', 'add', '--', *names], cwd=repo)
            run(['git', 'diff', '--cached', '--check'], cwd=repo)
            run(['git', 'commit', '-m', f'content: update infosec briefing {run_id}'], cwd=repo)
            record.update(commit=git(repo, 'rev-parse', 'HEAD'), stage='committed')
            save_json(record_path, record)
            verify_release(repo, record['commit'], record['hashes'])
            run(['git', 'push', 'origin', 'HEAD:refs/heads/main'], cwd=repo)
            record['stage'] = 'pushed'
            save_json(record_path, record)
            deploy(cfg, repo, record, record_path)
        except BaseException as exc:
            record['error'] = str(exc)
            save_json(record_path, record)
            say(f'停止: {exc} / 段階: {record["stage"]} / 保存先: {run_dir}')
            if record.get('commit') and record['stage'] in ('committed', 'pushed', 'deploying', 'deployed-awaiting-verification'):
                say(f'公開再試行: update-infosec --retry-deploy {run_id}')
            raise
        finally:
            sys.stdout.flush()
            sys.stderr.flush()
            os.dup2(saved_stdout, 1)
            os.dup2(saved_stderr, 2)
            os.close(saved_stdout)
            os.close(saved_stderr)
            tee.stdin.close()
            tee.wait(timeout=30)


def main():
    parser = argparse.ArgumentParser(description='情報収集 → データ・サイト更新 → 検証 → GitHub commit/push → 本番デプロイ')
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--doctor', action='store_true', help='依存コマンド・認証・公開先を確認する')
    group.add_argument('--dry-run', action='store_true', help='調査・生成・検証まで（公開しない）')
    group.add_argument('--retry-deploy', metavar='RUN_ID', help='push済みの検証済みコミットだけ再デプロイする')
    args = parser.parse_args()
    os.umask(0o077)
    try:
        cfg = config()
        state = Path(cfg['state_dir']).expanduser()
        with lock(state):
            if args.doctor:
                doctor(cfg)
            elif args.retry_deploy:
                if Path(args.retry_deploy).name != args.retry_deploy or args.retry_deploy in ('.', '..'):
                    raise UpdateError('RUN_ID が不正です。')
                doctor(cfg)
                run_dir = state/'runs'/args.retry_deploy
                record_path = run_dir/'run.json'
                record = read_json(record_path)
                check_retry(run_dir/'repo', record, cfg['repo_url'])
                deploy(cfg, run_dir/'repo', record, record_path)
            else:
                execute(cfg, args.dry_run)
    except (UpdateError, KeyError) as exc:
        say(str(exc))
        return 1
    except KeyboardInterrupt:
        say('中断しました。保存済みログと実行状態を確認してください。')
        return 130
    return 0


if __name__ == '__main__':
    sys.exit(main())
