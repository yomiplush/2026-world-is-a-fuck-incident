def collect_oracle(cpu: str) -> dict:
    url = ORACLE_CPU.format(cpu=cpu)
    page = get(url).decode("utf-8", "replace")
    return {"source": url, "cpu": cpu, **parse_oracle_java(page)}


def collect_kev(days: int) -> tuple[list, dict]:
    """Return (recent entries, catalog metadata) as two separate files.

    `kev-recent.json` stays a bare list of CISA objects — that is the shape
    docs/04 links to, and it is one `jq '.[]'` away from being usable. The
    catalog version and counts go to `kev-catalog.json` so the list keeps its
    original shape.
    """
    raw = json.loads(get(KEV))
    cut = (dt.date.today() - dt.timedelta(days=days)).isoformat()
    v = raw["vulnerabilities"]
    recent = sorted((x for x in v if x["dateAdded"] >= cut),
                    key=lambda x: x["dateAdded"], reverse=True)
    java = [x["cveID"] for x in recent
            if re.search(r"java|jre|jdk",
                         (x.get("vendorProject") or "") + (x.get("product") or ""), re.I)]
    meta = {
        "source": KEV,
        "catalogVersion": raw.get("catalogVersion"),
        "dateReleased": raw.get("dateReleased"),
        "total": raw.get("count"),
        "window_days": days,
        "window_start": cut,
        "recent_count": len(recent),
        "java_entries_in_window": java,
    }
    return recent, meta


def collect_jvn(limit: int) -> dict:
    xml = get(JVN_RSS).decode("utf-8", "replace")
    out = []
    for block in re.findall(r"<item\b[^>]*>(.*?)</item>", xml, re.S):
        def grab(pat):
            m = re.search(pat, block, re.S)
            return norm(re.sub(r"<!\[CDATA\[|\]\]>", "", m.group(1))) if m else ""
        out.append({
            "title": grab(r"<title>(.*?)</title>"),
            "url": grab(r"<link>(.*?)</link>"),
            "issued": grab(r"<dcterms:issued>(.*?)</dcterms:issued>")
                      or grab(r"<dc:date>(.*?)</dc:date>"),
        })
    out.sort(key=lambda x: x["issued"], reverse=True)
    # JVN's feed is already short (~20 items), so keep all of it: a truncated
    # feed is what makes a doc say "20 items" while the file holds 12.
    kept = out[:max(limit, 30)]
    return {"source": JVN_RSS, "count": len(out), "returned": len(kept),
            "items": kept}


def parse_when(s: str) -> dt.datetime | None:
    s = (s or "").strip()
    if not s:
        return None
    if re.match(r"\d{4}-\d{2}-\d{2}T", s):
        try:
            return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
        except ValueError:
            return None
    try:
        d = email.utils.parsedate_to_datetime(s)
        return d if d.tzinfo else d.replace(tzinfo=dt.timezone.utc)
    except (TypeError, ValueError):
        return None


def collect_feeds(limit: int, feeds: dict[str, str] | None = None) -> dict:
    out = {}
    for name, url in (feeds or FEEDS).items():
        try:
            raw = get(url).decode("utf-8", "replace")
        except (urllib.error.URLError, OSError) as exc:
            out[name] = {"url": url, "error": str(exc)}
            print(f"  ! {name}: {exc}", file=sys.stderr)
            continue
        items = []
        for block in re.findall(r"<(?:item|entry)\b[^>]*>(.*?)</(?:item|entry)>", raw, re.S):
            def grab(pat):
                m = re.search(pat, block, re.S)
                return norm(re.sub(r"<!\[CDATA\[|\]\]>", "", m.group(1))) if m else ""
            title = grab(r"<title[^>]*>(.*?)</title>")
            link = grab(r'<link[^>]*href="([^"]+)"') or grab(r"<link>(.*?)</link>")
            when = parse_when(grab(r"<(?:pubDate|published|updated|dc:date)>([^<]+)</"))
            if title and when:
                items.append({"date": when.astimezone(dt.timezone.utc).date().isoformat(),
                              "title": title, "url": link})
        items.sort(key=lambda x: x["date"], reverse=True)
        out[name] = {"url": url, "count": len(items), "recent": items[:limit]}
    return out


def collect_news(limit: int) -> dict:
    """The trade press, stored as a lead channel — not as evidence.

    This is the channel that carried Node2Shell to the user before any CVE feed
    did (2026-10-23). Each item keeps its URL so the claim can be followed to
    the advisory or research post behind it; nothing here is citable on its own.
    """
    out = collect_feeds(limit, NEWS_FEEDS)
    out["channel"] = "trade-press"
    out["note"] = ("Secondary. Follow each item's URL to the primary source "
                   "before citing it.")
    return out


def collect_x_posts(ids: str) -> dict:
    """Archive the tracked X posts, one record each, with their outbound links.

    X's API needs credentials and the public timeline needs a browser; the
    syndication endpoint behind embedded posts answers without either, which is
    enough to keep the claim and the link it pushed. It is undocumented, so the
    saved JSON is the archive: a deleted post cannot be fetched again.
    """
    posts, errors = [], {}
    for tid in (i.strip() for i in ids.split(",")):
        if not tid:
            continue
        url = X_TWEET.format(id=tid)
        try:
            d = json.loads(get(url))
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as exc:
            errors[tid] = str(exc)
            print(f"  ! x/{tid}: {exc}", file=sys.stderr)
            continue
        if not d or d.get("__typename") != "Tweet":
            errors[tid] = "empty result (deleted, protected, or rate-limited)"
            print(f"  ! x/{tid}: {errors[tid]}", file=sys.stderr)
            continue
        user = d.get("user") or {}
        links = [{"display": u.get("display_url"), "expanded": u.get("expanded_url")}
                 for u in ((d.get("entities") or {}).get("urls") or [])]
        media = [{"type": m.get("type"), "url": m.get("expanded_url")}
                 for m in ((d.get("entities") or {}).get("media") or [])]
        posts.append({
            "id": d.get("id_str") or tid,
            "url": f"https://x.com/{user.get('screen_name', 'i')}/status/{tid}",
            "created_at": d.get("created_at"),
            "lang": d.get("lang"),
            "author": {"name": user.get("name"),
                       "screen_name": user.get("screen_name"),
                       "verification": user.get("verified_type")},
            "text": d.get("text"),
            "links": links,
            "media": media,
        })
    if not posts:
        raise ValueError(f"no X post could be read ({errors or 'no ids'})")
    return {
        "source": "https://cdn.syndication.twimg.com/tweet-result",
        "note": ("Undocumented syndication endpoint, no credentials. A post is a "
                 "lead: cite the link in `links`, not the post."),
        "tracked": [p["id"] for p in posts],
        "posts": posts,
        "errors": errors,
    }


def collect_php(lines: str) -> dict:
    """PHP's own news archive and the current release on each supported line.

    The archive entry *is* the advisory for anything PHP has not given a
    CVE page yet: 2026-10-23-1 is the whole public statement about
    CVE-2026-115560, and it says the fix waits for the next routine release.
    Keep its text verbatim — the wording ("unusual", "unlikely") is the claim.
    """
    year = dt.datetime.now(dt.timezone.utc).year
    page = get(PHP_ARCHIVE.format(year=year)).decode("utf-8", "replace")
    entries = []
    for block in re.findall(r'<article class="newsItem">(.*?)</article>', page, re.S):
        def grab(pat):
            m = re.search(pat, block, re.S)
            return norm(re.sub(r"<[^>]+>", " ", m.group(1))) if m else ""
        title = grab(r'<h2[^>]*class="newstitle"[^>]*>(.*?)</h2>')
        ident = grab(r'<a id="([^"]+)"')
        when = grab(r'<time[^>]*datetime="([^"]+)"')
        # the body starts with a nested <div class="newsImage">, so take the rest
        # of the article block and let the tag-stripper drop the closers
        rest = re.search(r'<div class="newscontent"[^>]*>(.*)', block, re.S)
        body = norm(re.sub(r"<[^>]+>", " ", rest.group(1))) if rest else ""
        if title:
            entries.append({"id": ident, "datetime": when, "title": title,
                            "date": when[:10], "text": body[:1200]})
    out = {"source": PHP_ARCHIVE.format(year=year), "year": year,
           "entries": entries[:15]}
    releases = {}
    for line in (i.strip() for i in lines.split(",")):
        if not line:
            continue
        d = json.loads(get(PHP_RELEASE.format(line=line)))
        if isinstance(d, dict) and not d.get("error"):
            releases[line] = {"version": d.get("version"), "date": d.get("date"),
                              "tags": d.get("tags")}
    out["releases"] = releases
    return out


def collect_msrc(month: str) -> dict:
    url = MSRC_CVRF.format(month=month)
    root = ET.fromstring(get(url))
    ns = {"v": "http://www.icasi.org/CVRF/schema/vuln/1.1"}
    rows, status = [], set()
    for v in root.findall(".//v:Vulnerability", ns):
        cve = (v.findtext("v:CVE", default="", namespaces=ns) or "").strip()
        title = (v.findtext("v:Title", default="", namespaces=ns) or "").strip()
        if not cve:
            continue
        scores = [float(s.text) for s in v.findall(
            "v:CVSSScoreSets/v:ScoreSet/v:BaseScore", ns) if s.text]
        impacts, exploit = set(), ""
        for t in v.findall("v:Threats/v:Threat", ns):
            desc = (t.findtext("v:Description", default="", namespaces=ns) or "").strip()
            if t.get("Type") == "Impact" and desc:
                impacts.add(desc)
            elif t.get("Type") == "Exploit Status" and desc:
                exploit = desc
        if exploit:
            status.add(exploit)
        rows.append({
            "cve": cve,
            "title": title,
            "cvss_base": max(scores) if scores else None,
            "impact": sorted(impacts),
            "exploit_status": exploit,
        })
    detected = sorted({r["cve"] for r in rows
                       if "Exploited:Yes" in r["exploit_status"]})
    disclosed = sorted({r["cve"] for r in rows
                        if "Publicly Disclosed:Yes" in r["exploit_status"]})
    cves = [r for r in rows if r["cve"].startswith("CVE-")]
    scored = [r for r in rows if r["cvss_base"] is not None]
    return {
        "source": url,
        "month": month,
        "entries": len(rows),
        "cve_entries": len(cves),
        "advisory_entries": len(rows) - len(cves),
        "exploited": detected,
        "publicly_disclosed": disclosed,
        "cvss_ge_9_8": sum(1 for r in scored if r["cvss_base"] >= 9.8),
        "cvss_ge_9_0": sum(1 for r in scored if r["cvss_base"] >= 9.0),
        "exploit_status_values": sorted(status),
        "vulnerabilities": sorted(rows, key=lambda r: -(r["cvss_base"] or 0)),
    }


# --------------------------------------------------------------------- GitLab

def rendered_lines(raw: str) -> list[str]:
    """Rendered text, one visible line per element. No third-party parser."""
    raw = re.sub(r"(?is)<(script|style)\b.*?</\1>", " ", raw)
    raw = re.sub(r"(?i)<br\s*/?>", "\n", raw)
    raw = re.sub(r"(?i)</(p|div|li|h[1-6]|tr|td|th)>", "\n", raw)
    text = html.unescape(re.sub(r"<[^>]+>", "", raw))
    return [norm(l) for l in text.split("\n") if norm(l)]


def collect_gitlab(slug: str) -> dict:
    """Parse a GitLab patch-release page into one record per CVE.

    GitLab renders each CVE as a heading line ("CVE-… - <title>") followed by a
    description, the impacted version ranges, the CVSS score with vector, and
    the reporter. Rebuilding the table from here keeps docs/09 checkable.
    """
    url = GITLAB_PATCH.format(slug=slug)
    flat = rendered_lines(get(url).decode("utf-8", "replace"))
    joined = " ".join(flat)

    cves, cur = [], None
    for line in flat:
        m = re.match(r"^(CVE-\d{4}-\d+)\s+-\s+(.+)$", line)
        if m:
            cur = {"cve": m.group(1), "title": m.group(2).strip(),
                   "description": "", "impacted_versions": "", "cvss_base": None,
                   "cvss_vector": None, "reporter": "", "_rest": []}
            cves.append(cur)
            continue
        if cur is None:
            continue
        cur["_rest"].append(line)

    seen, unique = set(), []
    for c in sorted(cves, key=lambda x: -len(" ".join(x["_rest"]))):
        if c["cve"] not in seen:
            seen.add(c["cve"])
            unique.append(c)
    cves = sorted(unique, key=lambda x: -(x.get("cvss_base") or 0))

    for c in cves:
        body = " ".join(c.pop("_rest"))
        d = re.search(r"(GitLab has remediated[^.]*\.)", body)
        c["description"] = d.group(1) if d else ""
        iv = re.search(r"Impacted Versions:\s*(.*?)\s*(?:CVSS\s+\d|Thanks\s|$)", body)
        c["impacted_versions"] = iv.group(1).strip() if iv else ""
        sc = re.search(r"CVSS\s+(\d+\.\d)\s*\((CVSS:3\.1/[A-Za-z:/]+)\)", body)
        if sc:
            c["cvss_base"] = float(sc.group(1))
            c["cvss_vector"] = sc.group(2)
        rep = re.search(r"Thanks\s+(\S+)\s+for reporting", body)
        c["reporter"] = rep.group(1) if rep else ""

    rel = re.search(r"On (\w+ \d{1,2}, \d{4}),? we released versions ([\d.,\s]+?)\s+for GitLab",
                    joined)
    det, i = [], 0
    while i < len(flat):
        if flat[i].startswith("Detecting CVE-"):
            for cand in flat[i + 1:i + 6]:
                # detection names are short labels, not the sentence introducing them
                if cand and not cand.endswith(".") and len(cand) < 60 \
                        and not cand.startswith("CVE-"):
                    det.append(cand)
                if len(det) == 2:
                    break
            break
        i += 1
    return {
        "source": url,
        "slug": slug,
        "release_date": rel.group(1) if rel else None,
        "fixed_versions": [v.strip() for v in rel.group(2).split(",")] if rel else [],
        "cve_count": len(cves),
        "max_cvss": max((c["cvss_base"] or 0 for c in cves), default=None),
        "detections": det,
        "cves": cves,
    }


def collect_litellm(repo: str, issue: str) -> dict:
    url = LITELLM_INCIDENT.format(repo=repo, issue=issue)
    d = json.loads(get(url))
    return {
        "source": url,
        "repo": repo,
        "issue": issue,
        "title": d.get("title"),
        "state": d.get("state"),
        "created_at": d.get("created_at"),
        "updated_at": d.get("updated_at"),
        "author": (d.get("user") or {}).get("login"),
        "body": d.get("body"),
    }


# ------------------------------------------------------------- vendor CSAF / NVD

def collect_csaf(adv_id: str) -> dict:
    """Read a CISA-published CSAF advisory (the machine-readable form of VA-*).

    Plex is the reason this exists: CISA published VA-26-266-01 nine days before
    the CVEs appeared in NVD, and it carries the fixed version in a
    machine-readable field. A vendor forum post does not.
    """
    url = PLEX_CSAF.format(id=adv_id)
    d = json.loads(get(url))
    fix = set()
    cves = []
    for v in d.get("vulnerabilities", []):
        for r in v.get("remediations", []) or []:
            m = re.search(r"Fixed in ([\w.]+)", r.get("details") or "")
            if m:
                fix.add(m.group(1))
        scores = [sc.get("cvss_v3", {}).get("baseScore") for sc in v.get("scores", [])]
        scores = [x for x in scores if isinstance(x, (int, float))]
        cves.append({
            "cve": v.get("cve"),
            "title": v.get("title"),
            "cvss_v3": scores[0] if scores else None,
            "notes": [n.get("text") for n in v.get("notes", []) or []],
        })
    return {
        "source": url,
        "advisory": d.get("document", {}).get("tracking", {}).get("id"),
        "title": d.get("document", {}).get("title"),
        "published": d.get("document", {}).get("tracking", {}).get("initial_release_date"),
        "current_release": d.get("document", {}).get("tracking", {}).get("current_release_date"),
        "fixed_versions": sorted(fix),
        "risk_evaluation": next((n.get("text") for n in d.get("document", {}).get("notes", [])
                                 if n.get("title") == "Risk Evaluation"), None),
        "cve_count": len(cves),
        "cves": cves,
    }


def epss_scores(ids: list[str]) -> tuple[dict, int]:
    """Scores, plus how many batches the API refused.

    FIRST rate-limits bursts — a broad sweep asks for four batches of 90 right
    after four NVD queries — and a swallowed 429 looks exactly like "nothing in
    this window has a score". Return the failure count so the snapshot can say
    which of the two happened instead of publishing an empty column.
    """
    out, failed = {}, 0
    for i in range(0, len(ids), 90):
        url = EPSS.format(ids=",".join(ids[i:i + 90]))
        try:
            d = json.loads(get(url))
        except (urllib.error.URLError, OSError, json.JSONDecodeError):
            failed += 1
            continue
        for e in d.get("data", []):
            out[e["cve"]] = float(e["epss"])
    return out, failed


def kev_cve_ids() -> set[str]:
    try:
        return {x["cveID"] for x in json.loads(get(KEV))["vulnerabilities"]}
    except (urllib.error.URLError, OSError, json.JSONDecodeError, KeyError):
        return set()


def cvss_primary(metrics: dict, kind: str) -> tuple:
    """Score and vector for a metric kind, preferring NVD's own assessment.

    NVD lists the CNA's metric ("Secondary") before its own ("Primary") on some
    records, and the two can disagree by whole severity bands: CVE-2026-95695 is
    Secondary 7.4 (IBM) and Primary 9.1 (NVD) at once. A severity-filtered query
    selected that row, so reading the first entry records a CRITICAL as HIGH.
    """
    group = metrics.get(kind, [])
    for e in group:
        if e.get("type") == "Primary":
            return e["cvssData"]["baseScore"], e["cvssData"].get("vectorString")
    for e in group:
        return e["cvssData"]["baseScore"], e["cvssData"].get("vectorString")
    return None, None


def nvd_entry(c: dict, kev: set[str]) -> dict:
    """One NVD CVE record, reduced to the columns a triage decision needs."""
    metrics = c.get("metrics", {})
    v31, vec31 = cvss_primary(metrics, "cvssMetricV31")
    v40, _ = cvss_primary(metrics, "cvssMetricV40")
    vendor = product = ""
    for conf in c.get("configurations", []) or []:
        for node in conf.get("nodes", []):
            for match in node.get("cpeMatch", []):
                parts = match["criteria"].split(":")
                if len(parts) > 4:
                    vendor, product = parts[3], parts[4]
                    break
            if vendor:
                break
        if vendor:
            break
    return {
        "cve": c["id"],
        "published": c["published"][:10],
        "last_modified": c.get("lastModified", "")[:19],
        "status": c.get("vulnStatus", ""),
        "cvss_v31": v31,
        "cvss_v40": v40,
        "vector_v31": vec31,
        "vendor": vendor,
        "product": product,
        "kev": c["id"] in kev,
        "description": (c.get("descriptions") or [{}])[0].get("value", ""),
    }


def summarise_nvd(entries: list, url: str, **window) -> dict:
    scores, failed = epss_scores([e["cve"] for e in entries])
    for e in entries:
        e["epss"] = scores.get(e["cve"])
    entries.sort(key=lambda e: (-(e["cvss_v31"] or 0), e["published"]))
    out = {
        "source": url,
        **window,
        "total": len(entries),
        "in_kev": sum(1 for e in entries if e["kev"]),
        "with_cpe": sum(1 for e in entries if e["vendor"]),
        "with_epss": sum(1 for e in entries if e["epss"] is not None),
        "epss_batches_failed": failed,
        "entries": entries,
    }
    if failed and not scores:
        out["epss_note"] = ("EPSS answered no batch — an empty column here means "
                            "'not measured', not '0%'.")
    return out


def collect_nvd_critical(days: int) -> dict:
    """Every CRITICAL CVE NVD published in the window, with KEV and EPSS flags.
    The point is not the list; it is that the list is mostly noise and you need
    the three columns here (CVSS, KEV, EPSS) to see which rows are not.
    """
    end = dt.datetime.now(dt.timezone.utc).date()
    start = end - dt.timedelta(days=days)
    q = ("pubStartDate={s}T00:00:00.000&pubEndDate={e}T23:59:59.999"
         "&cvssV3Severity=CRITICAL&resultsPerPage=2000")
    url = NVD + "?" + q.format(s=start.isoformat(), e=end.isoformat())
    d = get_nvd(url)
    entries = [nvd_entry(v["cve"], kev_cve_ids())
               for v in d.get("vulnerabilities", [])]
    return summarise_nvd(entries, url, window_start=start.isoformat(),
                         window_end=end.isoformat())


def collect_nvd_window(hours: int, mode: str) -> dict:
    """Everything NVD touched in the last H hours — every severity, no filter.

    Two different questions, deliberately kept apart:

    - `published`: what appeared. A CRITICAL-only sweep (the 14-day one in
      docs/13) hides the HIGH band, where most of a day's real work sits.
    - `modified`: what NVD *changed*. This is the sweep that would have caught
      CVE-2026-109619 dropping 9.8 -> 8.1 without waiting for someone to notice
      that a total had moved.

    Neither is a quality filter. Both are cheap; run them before believing a
    count from yesterday.
    """
    if mode not in ("published", "modified"):
        raise ValueError(f"unknown NVD window mode: {mode}")
    end = dt.datetime.now(dt.timezone.utc)
    start = end - dt.timedelta(hours=hours)
    fmt = "%Y-%m-%dT%H:%M:%S.000"
    key = "pub" if mode == "published" else "lastMod"
    kev = kev_cve_ids()

    # Ask in 6-hour slices. One 24-hour all-severity query takes ~60 s at the
    # server and returns up to 2,000 rows; slicing keeps each call quick, keeps
    # every slice under the page cap, and turns one timeout into a smaller
    # retryable unit. NVD allows 5 requests per 30 s without a key.
    seen, entries, urls = set(), [], []
    cursor = start
    while cursor < end:
        stop = min(cursor + dt.timedelta(hours=6), end)
        q = (f"{key}StartDate={cursor.strftime(fmt)}&{key}EndDate={stop.strftime(fmt)}"
             "&resultsPerPage=2000")
        url = NVD + "?" + q
        urls.append(url)
        d = get_nvd(url)
        for v in d.get("vulnerabilities", []):
            c = v["cve"]
            if c["id"] in seen:
                continue
            seen.add(c["id"])
            entries.append(nvd_entry(c, kev))
        cursor = stop
        if cursor < end:
            time.sleep(6)
    out = summarise_nvd(entries, urls[0], mode=mode, window_hours=hours,
                        window_start=start.strftime(fmt),
                        window_end=end.strftime(fmt))
    out["chunks"] = len(urls)
    if len(urls) > 1:
        out["source_queries"] = urls
    return out


def collect_ghsa(hours: int) -> dict:
    """Recent advisories from the GitHub Advisory Database (GHSA).

    One request: the unauthenticated rate limit is 60/hour, and this endpoint
    returns the newest advisories sorted by publication. It is the ecosystem
    view NVD does not give you — which npm / pip / Go / Maven package, which
    patched version — so a supply-chain incident shows up here before it shows
    up as a CVE record.
    """
    end = dt.datetime.now(dt.timezone.utc)
    cut = end - dt.timedelta(hours=hours)
    url = GHSA + "?per_page=100&sort=published&direction=desc"
    d = json.loads(get(url))
    rows, skipped = [], 0
    for a in d:
        try:
            when = dt.datetime.fromisoformat(
                (a.get("published_at") or "").replace("Z", "+00:00"))
        except ValueError:
            skipped += 1
            continue
        if when < cut:
            continue
        rows.append({
            "ghsa": a.get("ghsa_id"),
            "cve": a.get("cve_id"),
            "summary": a.get("summary"),
            "severity": a.get("severity"),
            "cvss": (a.get("cvss") or {}).get("score"),
            "published": a.get("published_at", "")[:19],
            "updated": a.get("updated_at", "")[:19],
            "withdrawn": a.get("withdrawn_at"),
            "packages": [
                {"ecosystem": v.get("package", {}).get("ecosystem"),
                 "name": v.get("package", {}).get("name"),
                 "range": v.get("vulnerable_version_range"),
                 "patched": v.get("first_patched_version")}
                for v in a.get("vulnerabilities", []) or []
            ],
        })
    rows.sort(key=lambda r: r["published"], reverse=True)
    return {
        "source": url,
        "window_hours": hours,
        "window_start": cut.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "returned": len(d),
        "in_window": len(rows),
        "severities": sorted({r["severity"] for r in rows if r["severity"]}),
        "advisories": rows,
    }


# ----------------------------------------------------------------------- main

def main(argv: list[str]) -> int:
    today = dt.datetime.now(dt.timezone.utc).date()
    quarter = f"{['Jan', 'Apr', 'Jul', 'Oct'][(today.month - 1) // 3]}{today.year}"
    ap = argparse.ArgumentParser(prog="fetch-intel", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--date", default=today.isoformat(), help="output directory name")
    ap.add_argument("--cpu", default=quarter, help="Oracle CPU, e.g. Oct2026")
    ap.add_argument("--month", default=f"{today.year}-{today:%b}",
                    help="MSRC month, e.g. 2026-Oct")
    ap.add_argument("--kev-days", type=int, default=30, help="KEV look-back window")
    ap.add_argument("--limit", type=int, default=12, help="items per feed")
    ap.add_argument("--sources",
                    default="oracle,kev,jvn,php,feeds,news,x,msrc,gitlab,litellm,csaf,"
                            "nvd-critical,nvd-recent,nvd-modified,ghsa",
                    help="comma list of: oracle,kev,jvn,php,feeds,news,x,msrc,gitlab,"
                         "litellm,csaf,nvd-critical,nvd-recent,nvd-modified,ghsa")
    ap.add_argument("--gitlab-slug", default="patch-release-gitlab-19-5-1-released",
                    help="GitLab patch-release page slug (docs.gitlab.com/releases/patches/<slug>/)")
    ap.add_argument("--litellm-repo", default="BerriAI/litellm",
                    help="repo holding the LiteLLM compromise issue")
    ap.add_argument("--litellm-issue", default="47826",
                    help="issue number of the LiteLLM compromise report")
    ap.add_argument("--csaf-id", default="va-26-266-01",
                    help="CISA CSAF advisory id (csaf_files/IT/white/<year>/<id>.json)")
    ap.add_argument("--critical-days", type=int, default=14,
                    help="window for the NVD CRITICAL sweep")
    ap.add_argument("--php-lines", default="8.2,8.3,8.4,8.5",
                    help="PHP release lines whose current release is recorded")
    ap.add_argument("--recent-hours", type=int, default=24,
                    help="window for the broad NVD (published / modified) and GHSA sweeps")
    ap.add_argument("--x-posts", default=TRACKED_X_POSTS,
                    help="comma list of X post ids to archive (default: the tracked leads)")
    ap.add_argument("--out", default=None, help="output directory (default data/<date>)")
    args = ap.parse_args(argv)

    here = os.path.dirname(os.path.abspath(__file__))
    root = os.path.dirname(os.path.dirname(here))
    out_dir = args.out or os.path.join(root, "data", args.date)
    try:
        os.makedirs(out_dir, exist_ok=True)
    except OSError as exc:
        print(f"cannot create {out_dir}: {exc}", file=sys.stderr)
        return 1

    wanted = [s.strip() for s in args.sources.split(",") if s.strip()]

    def oracle_job():
        return [("oracle-java-" + args.cpu.lower() + ".json", collect_oracle(args.cpu))]

    def kev_job():
        recent, meta = collect_kev(args.kev_days)
        return [("kev-recent.json", recent), ("kev-catalog.json", meta)]

    jobs = {
        "oracle": oracle_job,
        "kev": kev_job,
        "jvn": lambda: [("jvn-recent.json", collect_jvn(args.limit))],
        "php": lambda: [("php-state.json", collect_php(args.php_lines))],
        "feeds": lambda: [("researcher-feeds.json", collect_feeds(args.limit))],
        "news": lambda: [("news-feeds.json", collect_news(args.limit))],
        "x": lambda: [("x-posts.json", collect_x_posts(args.x_posts))],
        "msrc": lambda: [("msrc-" + args.month.lower() + ".json",
                          collect_msrc(args.month))],
        "gitlab": lambda: [("gitlab-" + args.gitlab_slug + ".json",
                            collect_gitlab(args.gitlab_slug))],
        "litellm": lambda: [("litellm-issue-" + args.litellm_issue + ".json",
                             collect_litellm(args.litellm_repo, args.litellm_issue))],
        "csaf": lambda: [("csaf-" + args.csaf_id.lower() + ".json", collect_csaf(args.csaf_id))],
        "nvd-critical": lambda: [("nvd-critical-" + str(args.critical_days) + "d.json",
                                  collect_nvd_critical(args.critical_days))],
        "nvd-recent": lambda: [("nvd-recent-" + str(args.recent_hours) + "h.json",
                                collect_nvd_window(args.recent_hours, "published"))],
        "nvd-modified": lambda: [("nvd-modified-" + str(args.recent_hours) + "h.json",
                                  collect_nvd_window(args.recent_hours, "modified"))],
        "ghsa": lambda: [("ghsa-recent.json", collect_ghsa(args.recent_hours))],
    }
    unknown = [w for w in wanted if w not in jobs]
    if unknown:
        print(f"unknown source(s): {', '.join(unknown)}", file=sys.stderr)
        return 1

    failed, summary = 0, []
    for name in wanted:
        print(f"-> {name}", file=sys.stderr)
        try:
            produced = jobs[name]()
        except (urllib.error.URLError, http.client.HTTPException, OSError,
                ValueError, ET.ParseError, json.JSONDecodeError, KeyError) as exc:
            failed += 1
            print(f"  ! {name} failed: {exc}", file=sys.stderr)
            continue
        stamp = dt.datetime.now(dt.timezone.utc).isoformat(
            timespec="seconds").replace("+00:00", "Z")
        for filename, payload in produced:
            if isinstance(payload, dict):
                payload["fetched_at"] = stamp
                payload["tool"] = "tools/intel/fetch-intel"
            path = os.path.join(out_dir, filename)
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(payload, fh, ensure_ascii=False, indent=1)
                fh.write("\n")
            summary.append((name, path, payload, filename))

    print()
    for name, path, p, _ in summary:
        rel = os.path.relpath(path)
        if name == "oracle":
            print(f"Oracle Java {p['cpu']}: {p['cve_count_parsed']} CVEs parsed "
                  f"(advisory says {p['cve_count_reported']}), "
                  f"max CVSS {p['max_cvss']} -> {rel}")
        elif name == "kev" and isinstance(p, dict):
            print(f"KEV {p['catalogVersion']}: {p['recent_count']} added since "
                  f"{p['window_start']} -> {rel}")
        elif name == "kev":
            print(f"KEV: {len(p)} entries kept verbatim -> {rel}")
        elif name == "jvn":
            print(f"JVN: {p['count']} items in feed, {p['returned']} kept -> {rel}")
        elif name == "php":
            newest = p["entries"][0] if p["entries"] else {}
            print(f"php: {len(p['entries'])} archive entries, newest {newest.get('id', '?')} "
                  f"\"{newest.get('title', '')[:44]}\"; releases "
                  + ", ".join(f"{k} {v['version']}" for k, v in p["releases"].items())
                  + f" -> {rel}")
        elif name == "feeds":
            ok = sum(1 for k, v in p.items() if k in FEEDS and "recent" in v)
            empty = [k for k in FEEDS if k in p and not p[k].get("recent")]
            note = f" (empty: {', '.join(empty)})" if empty else ""
            print(f"feeds: {ok}/{len(FEEDS)} readable{note} -> {rel}")
        elif name == "news":
            ok = sum(1 for k, v in p.items() if k in NEWS_FEEDS and "recent" in v)
            print(f"news: {ok}/{len(NEWS_FEEDS)} readable, "
                  f"{sum(len(v.get('recent', [])) for k, v in p.items() if k in NEWS_FEEDS)} "
                  f"headlines -> {rel}")
        elif name == "x":
            print(f"x: {len(p['posts'])} post(s) archived "
                  f"({', '.join(p['tracked'])}) -> {rel}")
        elif name == "gitlab":
            print(f"GitLab {p['slug']}: {p['cve_count']} CVEs, "
                  f"max CVSS {p['max_cvss']} -> {rel}")
        elif name == "csaf":
            print(f"CSAF {p['advisory']}: {p['cve_count']} CVEs, "
                  f"fixed {', '.join(p['fixed_versions'])} -> {rel}")
        elif name == "nvd-critical":
            print(f"NVD CRITICAL {p['window_start']}..{p['window_end']}: "
                  f"{p['total']} CVEs, {p['in_kev']} in KEV, {p['with_epss']} with EPSS"
                  + (f" ({p['epss_batches_failed']} EPSS batches failed)" if p.get("epss_batches_failed") else "")
                  + f" -> {rel}")
        elif name in ("nvd-recent", "nvd-modified"):
            print(f"NVD {p['mode']} last {p['window_hours']}h: {p['total']} CVEs, "
                  f"{sum(1 for e in p['entries'] if (e['cvss_v31'] or 0) >= 9.0)} at >=9.0, "
                  f"{p['in_kev']} in KEV -> {rel}")
        elif name == "ghsa":
            print(f"GHSA last {p['window_hours']}h: {p['in_window']} advisories "
                  f"({', '.join(p['severities']) or 'none'}) -> {rel}")
        elif name == "litellm":
            print(f"LiteLLM issue #{p['issue']}: {(p['title'] or '')[:50]}... -> {rel}")
        elif name == "msrc":
            print(f"MSRC {p['month']}: {p['cve_entries']} CVEs, "
                  f"{len(p['exploited'])} exploited -> {rel}")

    if failed and not summary:
        print("\nnothing fetched", file=sys.stderr)
        return 2
    if failed:
        print(f"\n{failed} source(s) failed; the rest was written", file=sys.stderr)
        return 10
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
