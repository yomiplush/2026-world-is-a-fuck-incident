<script>
    if (window.innerWidth < 1024) {
        const categories = document.querySelectorAll('.b2-navigation-categories');

        categories.forEach(category => {

          const title = category.querySelector('.nav-dropdown-title');
          const dropdown = category.querySelector('.navdropdown');

          title.addEventListener('click', () => {
            categories.forEach(cat => {
              const otherDropdown = cat.querySelector('.navdropdown');
              if (otherDropdown && otherDropdown !== dropdown) {
                otherDropdown.style.display = 'none';
              }
            });

            if (dropdown) {
              dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
            }
          });
        });

         }

</script>
