<tr>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">Cloud Management - MS Graph</td>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">0de14c77-b9b0-4137-9360-34878a929827</td>
