<td style="border-color: #000000; border-width: 1px; padding: 12px;">ConnectWise Cloud Backup</td>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">506e08f9-6e9a-4da4-942b-a099a03644ae</td>
</tr>
<tr>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">ConnectWise Cloud Management</td>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">2399d300-6fca-4e6a-a686-399fefe75b83</td>
</tr>
