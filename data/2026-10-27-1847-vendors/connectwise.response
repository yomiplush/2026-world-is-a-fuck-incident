<tr>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">Cloud Management - Partner Center</td>
<td style="border-color: #000000; border-width: 1px; padding: 12px;">412dcf96-176d-4b3a-a1b0-4981ad66971e</td>
