2026-10-31",status:"none",incidents:$R[13712]=[]}]}]}]}}],activeIncidents:$R[13713]=[$R[13714]={id:"16d7fd98-a457-4bf5-bb45-6cda6ac05b46",slug:"O1VGXWU5",title:"Railway Recovery after October 21 Incident",status:"MONITORING",createdAt:"2026-10-26T19:12:29.715149+00:00",resolvedAt:null,components:$R[13715]=[$R[13716]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13717]=[$R[13718]={id:"3d341855-9700-4419-b2d1-f4d7e177ff06",status:"MONITORING",message:"Note: this is not an announcement of an additional incident.\n\nThere is no change since our last update. New signups remain paused while we prioritize reliability for existing customers during recovery. We do not have a date to share yet for re-enabling signups.\n\nThe latest information remains in our addendum at https://blog.railway.com/p/preliminary-report-october-security-incident#continuous-updates. We will post our next update around 15:00 UTC on October 27.",createdAt:"2026-10-27T03:22:16.828998+00:00"},$R[13719]={id:"8c8a9cab-8ce0-40c0-89cf-564330748e50",status:"MONITORING",message:"Note: this is not an announcement of an additional incident.\n\nAs we work to recover all of our systems after the October 21 Security Incident (https://blog.railway.com/p/preliminary-report-october-security-incident), we will be using this Status Page incident to provide updated information.\n\nIf you subscribe at the top of page at status.railway.com, you can get new updates as they are posted. We expect to post at least twice a day during the week until all parts of Railway are fully operational or if we decide on an alternate channel for such communication.\n\nWe have updated our original post with an addendum at https://blog.railway.com/p/preliminary-report-october-security-incident#continuous-updates, and will notify you here of any additional addendums.",createdAt:"2026-10-26T19:12:29.715149+00:00"}]}],recentIncidents:$R[13720]=[$R[13721]={id:"dcb99a2f-e1b0-4129-b91b-1b93758a7810",slug:"854ABT7N",title:"TLS certificates not generating",status:"RESOLVED",createdAt:"2026-10-26T19:18:16.627614+00:00",resolvedAt:"2026-10-26T20:02:48.178187+00:00",components:$R[13722]=[$R[13723]={id:"c9bc57e6-1e1f-4ce4-ad7f-8065e08997e2",name:"Provisioning",groupName:"Domains",impact:"MAJOR_OUTAGE"}],updates:$R[13724]=[$R[13725]={id:"11c33c87-9988-4da6-802b-a0ba89807e8c",status:"RESOLVED",message:"We have deployed a fix for the issue and TLS are generating again.",createdAt:"2026-10-26T20:02:48.178187+00:00"},$R[13726]={id:"4d75c976-5869-4c2a-9beb-d38c7a15d597",status:"IDENTIFIED",message:"We have received reports and identified the cause of TLS certs not generating for new or changed domains. We are talking to our upstream provider Lets Encrypt about this and will update shortly.",createdAt:"2026-10-26T19:18:16.627614+00:00"}]},$R[13727]={id:"16d7fd98-a457-4bf5-bb45-6cda6ac05b46",slug:"O1VGXWU5",title:"Railway Recovery after October 21 Incident",status:"MONITORING",createdAt:"2026-10-26T19:12:29.715149+00:00",resolvedAt:null,components:$R[13728]=[$R[13729]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13730]=[$R[13731]={id:"3d341855-9700-4419-b2d1-f4d7e177ff06",status:"MONITORING",message:"Note: this is not an announcement of an additional incident.\n\nThere is no change since our last update. New signups remain paused while we prioritize reliability for existing customers during recovery. We do not have a date to share yet for re-enabling signups.\n\nThe latest information remains in our addendum at https://blog.railway.com/p/preliminary-report-october-security-incident#continuous-updates. We will post our next update around 15:00 UTC on October 27.",createdAt:"2026-10-27T03:22:16.828998+00:00"},$R[13732]={id:"8c8a9cab-8ce0-40c0-89cf-564330748e50",status:"MONITORING",message:"Note: this is not an announcement of an additional incident.\n\nAs we work to recover all of our systems after the October 21 Security Incident (https://blog.railway.com/p/preliminary-report-october-security-incident), we will be using this Status Page incident to provide updated information.\n\nIf you subscribe at the top of page at status.railway.com, you can get new updates as they are posted. We expect to post at least twice a day during the week until all parts of Railway are fully operational or if we decide on an alternate channel for such communication.\n\nWe have updated our original post with an addendum at https://blog.railway.com/p/preliminary-report-october-security-incident#continuous-updates, and will notify you here of any additional addendums.",createdAt:"2026-10-26T19:12:29.715149+00:00"}]},$R[13733]={id:"791f87ad-fcba-44d2-9908-348961c108e3",slug:"QORAHHDA",title:"Degraded snapshot upload latency",status:"RESOLVED",createdAt:"2026-10-26T11:25:05.743574+00:00",resolvedAt:"2026-10-26T23:43:19.658751+00:00",components:$R[13734]=[$R[13735]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[13736]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"},$R[13737]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13738]=[$R[13739]={id:"2d85d7d9-769b-4fb8-bf88-52f2d3838a63",status:"RESOLVED",message:"Snapshot upload latency has now resolved across all regions.",createdAt:"2026-10-26T23:43:19.658751+00:00"},$R[13740]={id:"4c0782ea-55b6-4b38-947f-967c9355c7e3",status:"MONITORING",message:"This latency is now normalizing in US West also, all other regions should be fully back to normal. We continue to monitor.",createdAt:"2026-10-26T22:57:01.487612+00:00"},$R[13741]={id:"11e82ff4-213e-43d2-a8ec-8847d2d28c0c",status:"IDENTIFIED",message:"We're still seeing elevated snapshot upload latency in US West (California), caused by the same issue with our upstream storage provider. Builds in this region may take longer than usual to start. We're working with our storage provider to restore normal upload times.\n\nEU West and Southeast Asia are now in recovery. Running deployments are not affected.\n\nNote: This is an issue with our upstream storage provider, unrelated to the security incident from October 21st, which has been resolved. No action is needed on your part.",createdAt:"2026-10-26T20:29:20.506578+00:00"},$R[13742]={id:"bf787ece-5919-4333-a200-88f8c50b393f",status:"IDENTIFIED",message:"Ongoing",createdAt:"2026-10-26T19:14:37.359858+00:00"},$R[13743]={id:"d06748c0-eedc-43da-80f9-8e4ee1c90289",status:"IDENTIFIED",message:"We're seeing elevated snapshot upload latency in US West (California) and Southeast Asia (Singapore), caused by the same issue with our upstream storage provider. Builds in these regions may take longer than usual to start. We're working with our provider to restore normal upload times.\n\nEU West continues to recover. Running deployments are not affected.\n\nNote: This is an issue with our upstream storage provider, unrelated to the security incident from October 21st, which has been resolved. No action is needed on your part.",createdAt:"2026-10-26T16:17:57.703080+00:00"},$R[13744]={id:"7912cf9e-40e4-43de-9037-57ffc08e4cd0",status:"MONITORING",message:"We’re seeing early signs of recovery in EU West. Snapshot upload times are improving and we’re monitoring closely.",createdAt:"2026-10-26T15:06:04.162162+00:00"},$R[13745]={id:"d51baa37-b823-4880-beb1-b58529af2987",status:"IDENTIFIED",message:"Due to sustained elevated latency, some builds in EU West may fail early. We’re still working with our provider to scale storage capacity.",createdAt:"2026-10-26T12:53:34.878684+00:00"},$R[13746]={id:"4a5fcc14-c033-4634-adf2-3a7be04d7b5b",status:"IDENTIFIED",message:"We've identified the cause with our upstream storage provider. We're working with them to scale it up and restore normal upload times. Builds in EU West may still be slower than usual in the meantime.",createdAt:"2026-10-26T11:30:59.545757+00:00"},$R[13747]={id:"b7fcc7ec-4495-491d-9e78-52471ddf95c1",status:"INVESTIGATING",message:"We’re investigating elevated latency on build snapshot uploads in EU West (Amsterdam). Builds in this region may take longer than usual to start. Running deployments are not affected.",createdAt:"2026-10-26T11:05:05.743+00:00"}]},$R[13748]={id:"6a263f9d-94bd-4770-8b66-3a871ffd90bc",slug:"FM0QZ3B1",title:"Some deployments failing in EU West",status:"RESOLVED",createdAt:"2026-10-25T22:04:54.584016+00:00",resolvedAt:"2026-10-25T23:24:35.433800+00:00",components:$R[13749]=[$R[13750]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13751]=[$R[13752]={id:"e8255adb-c622-441d-b292-883fc4bd88f2",status:"RESOLVED",message:"This incident has been resolved. Deployments in EU West (Amsterdam) are succeeding normally. If a deployment failed during this incident, please redeploy it.",createdAt:"2026-10-25T23:24:35.433800+00:00"},$R[13753]={id:"f48b815c-6eaa-4e3b-b615-45befd5eccdf",status:"MONITORING",message:"A fix has been applied and deployments in EU West (Amsterdam) should now succeed. If a deployment failed during this incident, please redeploy it. We are monitoring the results.",createdAt:"2026-10-25T23:19:18.553055+00:00"},$R[13754]={id:"914a6cfc-21b1-43aa-9ec4-6f31494d4786",status:"IDENTIFIED",message:"We are aware of an issue causing some deployments in EU West (Amsterdam) to fail. Builds may complete successfully but then fail to deploy.\n\nWe have identified the cause and are working on a fix.",createdAt:"2026-10-25T22:04:54.584016+00:00"}]},$R[13755]={id:"467aaa06-c7e1-44a3-bf85-b303e2cf968f",slug:"8E4V5WLD",title:"Clarification: Recent Oct 24 API key revocations are precautionary",status:"RESOLVED",createdAt:"2026-10-24T13:57:07.876852+00:00",resolvedAt:"2026-10-25T06:26:51.728221+00:00",components:$R[13756]=[$R[13757]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"OPERATIONAL"}],updates:$R[13758]=[$R[13759]={id:"82baab6f-4306-4776-bc77-1f1b20f33287",status:"RESOLVED",message:"Dismissed as a notice. No impact.",createdAt:"2026-10-25T06:26:51.728221+00:00"},$R[13760]={id:"7b396716-9cab-42cf-88f9-591dc401df1b",status:"TRIAGE",message:"Railway is not currently under attack.\n\nRecent API key revocations by AI providers are precautionary actions in response to the October 21 incident, not a new security incident. \n\nOn October 23, after the attacker’s access had been fully removed on October 22 at 03:32 UTC, AI providers requested another batch of potentially affected keys. We provided that batch to OpenAI and Anthropic, but because we could not filter keys by when they were added, it inadvertently included newer keys. As a result, providers may have revoked replacement keys you created after the incident. These revocations do not indicate that your replacement keys were compromised. \n\nYou should also receive communications directly from the providers taking action, explaining their response and any steps you need to take.\n\nIf a provider revoked your key, create a replacement, update the corresponding Railway environment variable, and redeploy the services that use it. If your keys are still working, this notice does not require you to repeat completed rotations. We’re sorry for the confusion and additional disruption.",createdAt:"2026-10-24T13:57:07.876852+00:00"}]},$R[13761]={id:"2ba4507e-62d6-49a4-8b86-4306499865d8",slug:"ZEO9X68O",title:"station.railway.com is unavailable",status:"RESOLVED",createdAt:"2026-10-23T22:03:27.289376+00:00",resolvedAt:"2026-10-27T03:20:33.957218+00:00",components:$R[13762]=[$R[13763]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"OPERATIONAL"}],updates:$R[13764]=[$R[13765]={id:"59f78b2a-3fd1-430f-a0de-1753062755c3",status:"RESOLVED",message:"Dismissed as a notice. No impact.",createdAt:"2026-10-27T03:20:33.957218+00:00"},$R[13766]={id:"db012971-530b-447c-ad61-0a0e2d49d858",status:"TRIAGE",message:"Our support and community site, station.railway.com, is now restored, you can raise support threads on that property. We have caught up with most support requests.\n\nNew account signups remain paused and some non-essential product features remain disabled. We will update this notice as functionality restores.",createdAt:"2026-10-23T22:03:27.289376+00:00"}]},$R[13767]={id:"9bc9a3c0-fe6b-4b95-bd09-9dc1179da308",slug:"QH8L8B3E",title:"Railway Platform Outage",status:"RESOLVED",createdAt:"2026-10-21T07:24:24.727677+00:00",resolvedAt:"2026-10-23T22:06:13.736516+00:00",components:$R[13768]=[$R[13769]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13770]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13771]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[13772]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"},$R[13773]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"MAJOR_OUTAGE"}],updates:$R[13774]=[$R[13775]={id:"4f967ae4-e6d9-423b-a993-29517e78dd4a",status:"RESOLVED",message:"This incident has been resolved. Builds, deployments, the Railway API, and the dashboard are operating normally.\n\nNew signups remain temporarily paused while we focus on existing customers. station.railway.com remains unavailable, and we are tracking it in a separate notice here https://status.railway.com/incident/ZEO9X68O\n\nOur preliminary report on the October 21 security incident is available at https://blog.railway.com/p/preliminary-report-october-security-incident. If you have not already done so, please rotate sensitive credentials stored in Railway environment variables, revoke the old credentials, and redeploy dependent services.\n\nWe apologize for the disruption. For help, contact support@railway.com.",createdAt:"2026-10-23T22:06:13.736516+00:00"},$R[13776]={id:"04c51eb1-58ea-4357-b43b-2cd51779a4a8",status:"MONITORING",message:"Builds are operational, but they may take longer than usual to start or finish while we work through redeploys across the platform.\n\nThe Railway API and dashboard are fully functional. Our support and community site, station.railway.com, remains unavailable while we work on restoring our remaining non-critical services. For help in the meantime, contact support@railway.com.\n\nNew signups remain temporarily paused while we focus on existing customers.\n\nWe will continue to monitor and post another update once build times are back to normal.",createdAt:"2026-10-23T20:43:26.411715+00:00"},$R[13777]={id:"1a6cbe97-8d25-460e-b081-d99bd0030f82",status:"MONITORING",message:"We’ve published our preliminary report on the October 21 security incident. This is an update on the existing incident, not a new incident. As of October 23 at 18:57:54 UTC, we have completed notifications to users whose workspaces met our criteria for increased risk. No further higher-risk notifications are pending based on our findings as of that time. If new findings change our assessment of your workspace, we will contact you directly.\n\nWorkspaces outside those higher-risk groups are not confirmed safe from compromise. If you have not already done so, please rotate sensitive credentials stored in Railway environment variables during the incident, revoke the old credentials, update your variables, and redeploy dependent services. Continue reviewing provider activity for suspicious usage. If you have already completed these rotations since the incident was contained, this update alone does not require you to repeat them. For help, contact support@railway.com.",createdAt:"2026-10-23T19:18:30.250753+00:00"},$R[13778]={id:"d172ae0b-5d96-478d-b534-36b3d77bf0ae",status:"IDENTIFIED",message:"The preliminary report is now available: https://blog.railway.com/p/preliminary-report-october-security-incident\n\nOur investigation is still ongoing and we are still reaching out to customers we believe are at risk. Our team will remain engaged on the matter until we have notified everyone we believe is at risk.",createdAt:"2026-10-23T16:38:02.013670+00:00"},$R[13779]={id:"df027a7d-6ff3-4244-bfaa-1bc99f5fbe81",status:"IDENTIFIED",message:"We are in the process of publishing the preliminary report. A clarifying addendum on outreach emails, the Railway engineering team has performed preliminary forensics on the intent of the attacker, as such, we have bucketed customers based on risk of exposure based on logs and data we have collected over the last 48 hours. \n\nWe have already sent the emails to highest risk targeted workspaces. We are now actively sending emails to the remaining buckets of users where they are considered at risk. If you have known compromised use of a token, please reach out to support@railway.com which will help us with our investigation.",createdAt:"2026-10-23T16:15:28.312755+00:00"},$R[13780]={id:"801a65ac-bc97-4dcb-be92-30a62d86fa39",status:"IDENTIFIED",message:"Reminder: if you are facing issues with deployments, you may need to disconnect and reconnect your GitHub integration. Redeploying code from before the incident would not work and result in an error.\n\nBuilds and deployments for workspaces continue to run normally, and there is no other change since our last update.",createdAt:"2026-10-23T09:34:26.450140+00:00"},$R[13781]={id:"5727bcf3-ddcf-4ab2-a82a-3fefea23e0a7",status:"IDENTIFIED",message:"Builds and deployments for Enterprise, Pro, Hobby, Trial and Free workspaces are proceeding normally. \n\nNew signups remain temporarily paused while we focus on existing customers.\n\nWe have notified customers with a very high likelihood of impact by email. We are still conducting forensic analysis to find more cohorts of likelihood of impact. The team still expects the preliminary report by noon EST.",createdAt:"2026-10-23T08:09:08.722424+00:00"},$R[13782]={id:"f7803462-315e-45ac-82c8-8c15586b733e",status:"IDENTIFIED",message:"Builds may stay in a queued state while the Railway team deploys an upgrade to the build system. This update is not related to the security disclosure.\n\nNew signups remain temporarily paused while we focus on existing customers.",createdAt:"2026-10-23T07:37:03.126090+00:00"},$R[13783]={id:"93c31869-1cce-4fe2-8178-9f4ce8099103",status:"IDENTIFIED",message:"We are continuing to send notification emails to customers with high likelihood of impact. At the current pace, we expect this to take at least several more hours, but we cannot give a reliable estimate for when all emails will be sent. We will post an update once sending is complete, or sooner if there are any material changes. We apologize that we cannot provide a more definite timeline.\n\nWe still plan to publish our Preliminary Incident Report around midday Eastern Time on October 23.",createdAt:"2026-10-23T03:00:51.736074+00:00"},$R[13784]={id:"ccbddfdd-5267-4fd1-a4a0-0615c615e0cc",status:"IDENTIFIED",message:"We are continuing to notify customers with a high likelihood of impact by email. We will update this status page as soon as all notification emails have been sent. We will post an update not later than 03:00 UTC on October 23.",createdAt:"2026-10-23T02:19:18.515197+00:00"},$R[13785]={id:"f9d6daf8-cda4-4d7b-8a54-8fba5cdc2c3a",status:"IDENTIFIED",message:"We had been targeting publication of our Preliminary Incident Report tonight, but we need more time before it is ready to publish. We are notifying customers with high likelihood of impact by email now.\n\nBuilds and deployments for Enterprise, Pro, Hobby, Trial and Free workspaces remain available and are proceeding normally. New signups remain temporarily paused while we focus on existing customers.\n\nWe will share further updates as new information becomes available and link to the report here when it is published.",createdAt:"2026-10-23T02:00:24.232047+00:00"},$R[13786]={id:"851800d2-10c1-436c-bf53-55d0e1dd22c8",status:"IDENTIFIED",message:"There are no meaningful changes since our last update. Builds and deployments for Enterprise, Pro, Hobby, Trial and Free workspaces are proceeding normally.\n\nWe are continuing to work on completing our Preliminary Incident Report and will share it here when it is published.\n\nNew signups remain temporarily paused while we focus on existing customers.\n\nWe will provide another update by 02:00 UTC on October 23 at the latest.",createdAt:"2026-10-23T00:51:36.441689+00:00"},$R[13787]={id:"3d8ef55e-4850-4214-a91c-6c24e26b3a16",status:"IDENTIFIED",message:"Builds and deployments across Enterprise, Pro, Hobby, Trial and Free workspaces continue to run at approximately normal speed.\n\nWe remain on track to publish our Preliminary Incident Report soon and will share it here when it is available.\n\nNew signups remain temporarily paused while we focus on existing customers. \n\nWe will provide another update by 01:00 UTC on October 23 at the latest.",createdAt:"2026-10-23T00:11:12.619998+00:00"},$R[13788]={id:"a0494fce-f562-4c46-8fa5-e599561756bb",status:"IDENTIFIED",message:"Builds and deployments for Enterprise, Pro, Hobby, Trial and Free workspaces continue to run at approximately normal speed.\n\nWe are working to publish our Preliminary Incident Report soon. New signups remain temporarily paused while we focus on existing customers.\n\nWe will provide another update by 00:15 UTC on October 23 at the latest.",createdAt:"2026-10-22T23:22:28.821964+00:00"},$R[13789]={id:"c7c87449-0ffb-418f-91f5-0598444b16e7",status:"IDENTIFIED",message:"Builds are now available for Free and Trial workspaces, alongside Hobby, Pro and Enterprise. Builds and deployments across all five plans are running at approximately normal speed.\n\nNew signups remain temporarily paused while we focus on existing customers.\n\nWe will provide another update by 23:30 UTC at the latest.",createdAt:"2026-10-22T22:49:31.584701+00:00"},$R[13790]={id:"565d248b-3f65-4223-8b0a-7976abfc8965",status:"IDENTIFIED",message:"Builds and deployments for Hobby, Pro and Enterprise workspaces are running at approximately normal speed.\n\nWe are continuing to work on enabling builds for Free and Trial workspaces and will post here when they become available. New signups remain temporarily paused while we focus on existing customers.\n\nWe will provide another update by 23:30 UTC at the latest.",createdAt:"2026-10-22T22:41:49.384269+00:00"},$R[13791]={id:"c576e4da-d144-47ed-bbbf-0cf19d0c22d1",status:"IDENTIFIED",message:"Builds are enabled for Hobby, Pro and Enterprise workspaces. Builds and deployments are generally completing successfully but may still take longer than usual to complete.\n\nWe will provide an update when we enable builds for Free and Trial workspaces. New signups remain temporarily paused while we focus on existing customers.\n\nWe will provide another update by 22:45 UTC at the latest.",createdAt:"2026-10-22T21:59:08.267336+00:00"},$R[13792]={id:"34e36bda-3e31-4bc6-90ca-ffaf6efb850a",status:"IDENTIFIED",message:"Builds are now available for Hobby workspaces. We’ve published Security Guides to help you take the next steps relevant to your setup. You can find them on our engineering blog:\nhttps://blog.railway.com/engineering\n\nDeployments are likely to take longer than usual for Hobby users while we work through demand.\n\nOnce Hobby users are stable, we will work to enable builds for Free and Trial workspaces. New signups remain temporarily paused while we focus on existing customers.\n\nBuilds and deployments for Pro and Enterprise workspaces continue to start normally but may take longer to complete.\n\nWe will provide another update by 22:00 UTC at the latest.",createdAt:"2026-10-22T21:08:03.477829+00:00"},$R[13793]={id:"01af24f2-6e68-4742-a5b3-1903b305e20b",status:"IDENTIFIED",message:"Builds and deployments for Pro and Enterprise workspaces continue to run normally, and there is no other change since our last update. We are still working on enabling builds for Hobby, with Free and Trial to follow, and will post here as each is enabled. New signups remain temporarily paused.\n\nWe will provide another update by 21:15 UTC at the latest.",createdAt:"2026-10-22T20:29:59.312257+00:00"},$R[13794]={id:"1870d29c-4b0f-4131-9c49-454d987e80ce",status:"IDENTIFIED",message:"There is no change since our last update. New signups remain temporarily paused while we focus on existing customers. Builds and deployments for Pro and Enterprise workspaces are running normally, and enabling builds for Hobby remains our current focus. Free and Trial will follow after Hobby.\n\nWe will provide another update by 20:30 UTC at the latest.",createdAt:"2026-10-22T19:42:28.358862+00:00"},$R[13795]={id:"fb27546f-3ce0-43ca-8add-faab599ecdb0",status:"IDENTIFIED",message:"We have temporarily paused new signups so we can focus on making sure everything is working well for existing customers. We will re-enable signups once that is done, and will post here when they are available again.\n\nBuilds and deployments for Pro and Enterprise workspaces continue to run normally. We are still working on enabling builds for Hobby, followed by Free and Trial, and will post here as each is enabled.\n\nWe will provide another update by 19:45 UTC at the latest.",createdAt:"2026-10-22T19:06:13.960494+00:00"},$R[13796]={id:"00e65636-ebf7-4a17-bf96-7730cc500c0b",status:"IDENTIFIED",message:"Deployments in US West are working normally again. If a deployment in US West failed after its build completed, please redeploy the service.\n\nBuilds and deployments for Pro and Enterprise workspaces continue to run normally, and we are still working on enabling builds for Hobby. We will post here as soon as they are available.\n\nWe will provide another update by 19:15 UTC at the latest.",createdAt:"2026-10-22T18:49:33.601892+00:00"},$R[13797]={id:"3dd5b51c-0e44-437c-ad2c-e851d5a7a772",status:"IDENTIFIED",message:"We are aware that some deployments in US West are failing, even after their build completes successfully. We are investigating and working on a fix. Deployments in other regions are not affected by this issue.\n\nWe will provide another update by 19:15 UTC at the latest.",createdAt:"2026-10-22T18:42:12.231926+00:00"},$R[13798]={id:"5000cc47-1a4e-4aa2-a026-72588e3599b4",status:"IDENTIFIED",message:"Builds and deployments for Pro and Enterprise workspaces are running normally, and there is no change to report since our last update. We are still working on enabling builds for Hobby, and will post here as soon as they are available. Free and Trial will follow after Hobby.\n\nIf a build fails shortly after it starts, please retry it.\n\nWe will provide another update by 19:15 UTC at the latest.",createdAt:"2026-10-22T18:30:07.317001+00:00"},$R[13799]={id:"1523fa66-03bc-4f47-81af-a93d6cdff265",status:"IDENTIFIED",message:"There is no change since our last update. Builds and deployments for Pro and Enterprise workspaces continue to run at normal speed. If your build fails shortly after it starts, please retry it once.\n\nWe are continuing to work on enabling builds for Hobby, which will be next, followed by Free and Trial. We will post here as each is enabled.\n\nWe will provide another update by 18:30 UTC at the latest.",createdAt:"2026-10-22T17:43:36.841505+00:00"},$R[13800]={id:"9315cad3-9e52-464d-b148-354990e3c35f",status:"IDENTIFIED",message:"The API is now fully restored, including features that were temporarily unavailable. API tokens and Project Tokens created before the security incident remain invalidated, so if you use the Public API or the cli with a token, please create a new token.\n\nDeployments for both Pro and Enterprise workspaces have been available since 06:30 UTC and continue to run at normal speed. The build failure errors we were seeing before should now be resolved. If your build does still fail shortly after start, please retry it once. \n\nWe are working to enable builds for Hobby, then Free and Trial, later today. We will post here as each is enabled, and will update this page if that changes. Once this incident is resolved, we will publish a full incident report on our blog and link to it from this page.\n\nWe will provide another update by 17:45 UTC at the latest.",createdAt:"2026-10-22T17:00:12.683541+00:00"},$R[13801]={id:"732d20bf-469e-462f-bdca-9415063adc57",status:"IDENTIFIED",message:"Deployments for Pro and Enterprise workspaces are now running at normal speed. We are working to get builds enabled for Hobby next, and will post here when they are enabled.\n\nWe are aware that some builds are failing shortly after they start, and we are working on a fix. If your build fails this way, please retry it once.\n\nWe will provide another update by 17:00 UTC at the latest.",createdAt:"2026-10-22T16:14:19.616011+00:00"},$R[13802]={id:"dc8a3afc-a318-40e5-81f1-1ef459f30487",status:"IDENTIFIED",message:"Deployments for Pro and Enterprise workspaces continue to run a little slower than usual, and some may take longer than expected to complete. We are working to bring them back to normal speed.\n\nWe will post here when builds for Hobby, Free and Trial are re-enabled.\n\nWe will provide another update by 16:15 UTC at the latest.",createdAt:"2026-10-22T15:29:42.624618+00:00"},$R[13803]={id:"a7bfd9af-8e07-47eb-a820-8863e485d820",status:"IDENTIFIED",message:"Deployments for Pro and Enterprise workspaces are running a little slower than usual, and some may take longer than expected to complete. We are working to bring them back to normal speed.\n\nWe are continuing to work on enabling builds for Hobby, then Free and Trial, and will post here as each is enabled.\n\nWe will provide another update by 15:30 UTC at the latest.",createdAt:"2026-10-22T14:50:34.665254+00:00"},$R[13804]={id:"6e0e3d6d-4502-45c4-beee-dfdf9bc8529a",status:"IDENTIFIED",message:"We have worked through the queue of delayed deployments, and deployments for Pro and Enterprise workspaces are now starting at normal speed. No action is needed for deployments that were queued.\n\nWe are continuing to work on enabling builds for Hobby, then Free and Trial, and will post here as each is enabled.\n\nWe will provide another update by 14:45 UTC at the latest.",createdAt:"2026-10-22T13:53:34.756024+00:00"},$R[13805]={id:"80084749-ad66-4e66-ba0c-05f62dc5ad83",status:"IDENTIFIED",message:"We have almost worked through the queue of delayed deployments, and wait times are close to normal. A small number of deployments may still take longer than usual to start.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 14:00 UTC at the latest.",createdAt:"2026-10-22T13:16:34.499168+00:00"},$R[13806]={id:"90aa6521-cf37-4f7f-9277-314f170f1664",status:"IDENTIFIED",message:"Deployment wait times are improving significantly as we work through the queue, and most deployments are now starting much sooner. Some may still take longer than usual to start. We are continuing to work on bringing deployment times fully back to normal.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 13:15 UTC at the latest.",createdAt:"2026-10-22T12:30:29.231076+00:00"},$R[13807]={id:"b225ba65-7354-4d47-8b64-2a29e1a9dd64",status:"IDENTIFIED",message:"Deployment wait times are coming down as we work through the queue, though some deployments may still take longer than usual to start. \n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 12:30 UTC at the latest.",createdAt:"2026-10-22T11:47:45.348797+00:00"},$R[13808]={id:"ffbc3e50-39b5-4b60-994b-9ce4c9a6193a",status:"IDENTIFIED",message:"The number of queued deployments has stopped growing, and queued deployments are now starting, though more slowly than usual. To avoid adding to the wait, please do not trigger the same deployment more than once. We are also continuing to work on build error rates.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 11:45 UTC at the latest.",createdAt:"2026-10-22T11:01:53.873074+00:00"},$R[13809]={id:"11429081-d2ab-465d-8c6f-94d8e9e7d250",status:"IDENTIFIED",message:"There is no change since our last update. Some builds are still failing more often than usual, and many deployments remain queued with longer than usual wait times. We are continuing to work on both.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 11:00 UTC at the latest.",createdAt:"2026-10-22T10:15:32.792845+00:00"},$R[13810]={id:"df774473-89ad-45ee-8549-7717d1d22e93",status:"IDENTIFIED",message:"Some builds are failing more often than usual, and we are working to bring error rates back down. Many deployments are also still queued, and wait times remain longer than usual. To avoid adding to the wait, please do not trigger the same deployment more than once.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 10:15 UTC at the latest.",createdAt:"2026-10-22T09:28:14.241707+00:00"},$R[13811]={id:"024d2423-5e0b-4720-8644-99dd77548f1f",status:"IDENTIFIED",message:"There is no change since our last update. Many deployments are still queued, and wait times may be longer than earlier. To avoid adding to the wait, please do not trigger the same deployment more than once. We are continuing to work on bringing deployment times back to normal.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 09:30 UTC at the latest.",createdAt:"2026-10-22T08:44:43.790882+00:00"},$R[13812]={id:"0c7ec690-b999-45a6-98aa-0d7a238e4f95",status:"IDENTIFIED",message:"Deployments are going live, but many are taking longer than usual to start and may stay queued for some time. To avoid adding to the wait, please do not trigger the same deployment more than once. We are working to bring deployment times back to normal.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 08:45 UTC at the latest.",createdAt:"2026-10-22T08:01:59.800989+00:00"},$R[13813]={id:"5aed115f-820b-4f36-a8ec-695e3cea06ff",status:"IDENTIFIED",message:"Deployments are currently taking longer than usual to start, and some may stay queued for longer than expected. We are investigating and working to bring them back to normal speed.\n\nBuilds remain available for Pro and Enterprise workspaces. We are continuing to work on enabling builds for Hobby, then Free and Trial.\n\nWe will provide another update by 08:00 UTC at the latest.",createdAt:"2026-10-22T07:11:27.272817+00:00"},$R[13814]={id:"6b745a72-aa24-4a67-b186-1c8186d4f731",status:"IDENTIFIED",message:"Builds are now available for Pro and Enterprise workspaces. Pro customers can now complete the steps in our published guides that require a redeploy.\n\nWe will provide another update by 07:10 UTC at the latest.",createdAt:"2026-10-22T06:29:41.723309+00:00"},$R[13815]={id:"60f6e675-9afb-4af2-9e32-1d0dceb587bd",status:"IDENTIFIED",message:"Enterprise deployments are now moving through each stage at normal speed, including the \"Running pre-deploy command\" stage. Deployments that were waiting at one stage are continuing on their own, and no action is needed.\n\nWe will provide another update by 06:45 UTC, or sooner if there is news before then.",createdAt:"2026-10-22T06:12:49.973609+00:00"},$R[13816]={id:"d0f2e7f5-ae55-4702-8d72-186001e996a3",status:"IDENTIFIED",message:"We are continuing to work on deployments that stay at one stage, such as \"Running pre-deploy command\", for longer than expected. There is no other change to report since our last update.\n\nBuilds remain available for Enterprise workspaces. We are continuing to work on enabling builds for Pro, Hobby, then Free and Trial.\n\nWe will provide another update by 06:45 UTC, or sooner if there is news before then.",createdAt:"2026-10-22T06:01:07.163193+00:00"},$R[13817]={id:"e451956f-f386-43ff-93a4-fb15979273df",status:"IDENTIFIED",message:"Deployments are taking longer than usual to progress through each stage. Users may see a deployment stay at one status, such as \"Running pre-deploy command\", for longer than expected. We are investigating and working on a fix.\n\nWe will provide another update by 06:00 UTC at the latest.",createdAt:"2026-10-22T05:20:28.501940+00:00"},$R[13818]={id:"7e16cf49-563f-4960-a3c0-b8f272d30d73",status:"IDENTIFIED",message:"The Redeploy feature has been fixed. Enterprise customers can now use the Redeploy feature.\n\nWe are continuing to work on enabling builds for all other tiers.\n\nWe will provide another update by 05:30 UTC at the latest.",createdAt:"2026-10-22T04:52:26.258356+00:00"},$R[13819]={id:"1239438d-229f-404d-85bc-1b47947259c9",status:"IDENTIFIED",message:"Services with pre-deploy commands are stuck at the “Running pre-deploy command” stage. We are currently investigating and working on a fix.\n\nWe will provide another update by 05:15 UTC at the latest.",createdAt:"2026-10-22T04:39:30.522231+00:00"},$R[13820]={id:"40e58664-41f6-43a0-a0ea-3d047a311e17",status:"IDENTIFIED",message:"In accordance with our security disclosure, we have invalidated all Railway API tokens. If you are using an API token to integrate with Railway’s Public API (https://docs.railway.com/integrations/api), it will no longer work. Please create new API tokens on Railway to continue using Railway’s Public API.\n\nWe will provide another update by 05:00 UTC at the latest.",createdAt:"2026-10-22T04:17:16.062655+00:00"},$R[13821]={id:"529fd4e1-47d7-488b-a9d4-f9f9f7b383c8",status:"IDENTIFIED",message:"Builds for Enterprises continue to be available.\n\nPlease note that the Redeploy feature is currently unavailable. To initiate a redeploy, please browse to your service -> Ctrl/CMD+K -> Deploy Latest Commit. We are working to re-enable the Redeploy feature and will provide an update as soon as available.\n\nWe will provide another update by 04:45 UTC at the latest.",createdAt:"2026-10-22T04:00:12.919500+00:00"},$R[13822]={id:"f6f7a59e-2dd8-44ca-9d9f-86bbd36116b9",status:"IDENTIFIED",message:"Builds for Enterprise workspaces are now available. Enterprise customers can now complete the steps in our published guides that require a redeploy, including applying any new credentials you have added in Railway.\n\nPro, Hobby, then Free and Trial will follow in stages. We will post here as each is enabled, and the guides remain the recommended next steps regardless of plan.\n\nWe will provide another update by 04:15 UTC or sooner.",createdAt:"2026-10-22T03:32:45.513006+00:00"},$R[13823]={id:"35468fc5-d339-44b1-a939-1b61e2fd4941",status:"IDENTIFIED",message:"Builds remain paused. We are continuing to work to bring them back online and expect to have an update for Enterprise users here soon.\n\nThe guides published earlier cover the steps you can begin taking now. We will provide another update by 03:45 UTC, or sooner if there is news before then.",createdAt:"2026-10-22T03:00:31.464250+00:00"},$R[13824]={id:"6db29b9f-83ad-4649-8eae-298cd253f9a7",status:"IDENTIFIED",message:"We are still working to bring builds back online. There is no change to report since our last update.\n\nThe guides published in our previous update cover the recommended next steps regarding the security notice. Some of those steps require a redeploy and will have to wait until builds are available, but others you can begin now.\n\nWe will provide another update by 03:00 UTC, or sooner if builds are back before then.",createdAt:"2026-10-22T02:19:10.848124+00:00"},$R[13825]={id:"aba559d9-53b3-4bc8-b276-ec3267aacb17",status:"IDENTIFIED",message:"We have published guides to help users through recommended next steps regarding the security notice. These guides may require redeployment of services which you will not be able to complete until Builds are available again. However, there are steps you may begin to take. We will update as soon as Builds are available. This page remains the fastest place for updates.\n\nPublished Guides:\n- Check for Unexpected OpenRouter Usage: https://blog.railway.com/p/security-disclosure-recommendation-check-for-unexpected-openrouter-usage\n- Rotate PostgreSQL Database Credentials: https://blog.railway.com/p/security-disclosure-recommendation-rotate-postgresql-database-credentials\n- Check for Unexpected Grok Usage: https://blog.railway.com/p/security-disclosure-recommendation-check-for-unexpected-grok-usage\n- Redeploy Buckets and Reconnect GitHub After the Credential Reset: https://blog.railway.com/p/security-disclosure-recommendation-redeploy-buckets-and-reconnect-github-after-the-credential-reset\n- Check for Unexpected Anthropic Usage: https://blog.railway.com/p/security-disclosure-recommendation-check-for-unexpected-anthropic-usage\n- Check for Unexpected OpenAI Usage: https://blog.railway.com/p/security-disclosure-recommendation-check-for-unexpected-openai-usage\n- Check for Unexpected Usage in Stripe: https://blog.railway.com/p/security-disclosure-recommendation-check-for-unexpected-usage-in-stripe\n- Check for Anomalous GitHub Access: https://blog.railway.com/p/security-disclosure-recommendation-check-for-anomalous-github-access\n- Rotate MongoDB Database Credentials: https://blog.railway.com/p/security-disclosure-recommendation-rotate-mongodb-database-credentials\n- Rotate Redis Database Credentials: https://blog.railway.com/p/security-disclosure-recommendation-rotate-redis-database-credentials\n- Rotate MySQL Database Credentials: https://blog.railway.com/p/security-disclosure-recommendation-rotate-mysql-database-credentials\n- Check for Anomalous AWS Access: https://blog.railway.com/p/security-disclosure-recommendation-check-for-anomalous-aws-access\n- Check for Anomalous GCP Access: https://blog.railway.com/p/security-disclosure-recommendation-check-for-anomalous-gcp-access",createdAt:"2026-10-22T01:22:13.426637+00:00"},$R[13826]={id:"056fc22d-aa9e-47ec-9722-3305d5706429",status:"IDENTIFIED",message:"We are continuing to work to make builds available again. We will be publishing guides shortly to help users through recommended next steps regarding the security notice. This page remains the fastest place for updates.",createdAt:"2026-10-22T00:22:45.834158+00:00"},$R[13827]={id:"2e4a06cf-d5e6-400c-ae15-14bed91e73cc",status:"IDENTIFIED",message:"Please note that customers may see revocation of storage bucket credentials performed by Railway employee \"Faraz Patankar\" in their audit logs or activity panel. This is expected, as we previously indicated, we are revoking all existing storage bucket credentials out of an abundance of caution.",createdAt:"2026-10-21T22:45:55.455550+00:00"},$R[13828]={id:"53c6fbe9-f0f1-4f23-bf80-789f079ccaf3",status:"IDENTIFIED",message:"We are continuing to rotate bucket credentials and are working to make builds available again as soon as possible. We do not have further details to share right now, and this page remains the fastest place for updates as we learn more.\n\nIf you need to reach us, you can email support@railway.com. Please note that we may not be able to share more detail than is published here.\n\nBuilds remain paused. We will post here as soon as they resume.",createdAt:"2026-10-21T22:37:34.574983+00:00"},$R[13829]={id:"ca135bee-552d-428b-a744-fa62dcbf08d0",status:"IDENTIFIED",message:"We are rotating all Railway bucket credentials in response to the security incident. New credentials will appear in your dashboard automatically.\n\nBecause deployments are paused, you will not be able to redeploy your services to pick up the new credentials until builds are restored. We will post here when builds resume with any additional details.",createdAt:"2026-10-21T22:10:19.684347+00:00"},$R[13830]={id:"c793bb12-3717-4efc-b991-3494c19c10a9",status:"IDENTIFIED",message:"We have published a security notice covering what we know so far and the actions we recommend you take: https://blog.railway.com/p/security-disclosure-wednesday-october-21st\n\nWe strongly recommend that you revoke all environment variables stored in Railway, including API keys and private registry credentials, and review your service logs for unusual activity.\n\nDeployments remain paused while we investigate, including for Enterprise customers. We understand you are unable to update your applications with new credentials at this time and sincerely apologize for the inconvenience. We will post here when builds are restored.\n\nAs we confirm which accounts were affected, we will contact those customers directly by email.",createdAt:"2026-10-21T21:59:52.053227+00:00"},$R[13831]={id:"d4b30907-98cf-48ed-afdf-e36b09b49b28",status:"IDENTIFIED",message:"We do not yet have additional information to provide about the availability of builds. We apologize for the inconvenience and we will provide an update as soon as we can.",createdAt:"2026-10-21T21:01:02.847012+00:00"},$R[13832]={id:"6a9f2145-e9ee-4337-acc7-220e72f062be",status:"IDENTIFIED",message:"We are validating builds for Enterprise workspaces and should be re-enabling for Enterprises broadly very soon. Pro, Hobby, then Free and Trial will follow in stages, and we will post here as each is enabled.\n\nSome users will be signed out and will need to log in again.\n\nWe will continue posting updates at least every 30 minutes, and sooner if we have more information. The next update will by 21:00 UTC.",createdAt:"2026-10-21T20:35:06.001046+00:00"},$R[13833]={id:"ca688415-4041-461b-823a-046e541b91a3",status:"IDENTIFIED",message:"We are continuing to work towards enabling builds for Enterprise workspaces.\n\nWe will continue posting updates at least every 30 minutes, and sooner if we have more information. The next update will be at 21:00 UTC latest.",createdAt:"2026-10-21T20:30:33.036834+00:00"},$R[13834]={id:"8a4c96b6-557a-467b-a682-c3fcb655f8ce",status:"IDENTIFIED",message:"We are continuing to work on a fix for build issues. Due to impact from adjacent cache systems, we are invalidating OAuth sessions as part of our mitigation. Affected users will be signed out and will need to log in again.\n\nWe continue to expect builds for Enterprise workspaces to be available by 20:30 UTC. It is possible that this could be delayed by up to 30 minutes, but we will provide an update at 20:30 UTC regardless. Pro, Hobby, then Free and Trial will follow in stages, and we will post here as each is enabled.\n\nOur API, dashboard and station.railway.com remain affected.\n\nWe will continue posting updates at least every 30 minutes, and sooner if we have more information. The next update will be at 20:30 UTC.",createdAt:"2026-10-21T20:19:15.299566+00:00"},$R[13835]={id:"c0eb7ec2-c444-41a3-9c7b-b56462db5ceb",status:"IDENTIFIED",message:"We have mitigated some issues impacting builds and are continuing to work on bringing builds back online.\n\nWe continue to expect builds for Enterprise workspaces to be available by 20:30 UTC. Pro, Hobby, then Free and Trial will follow in stages, and we will post here as each is enabled.\n\nOur API, dashboard and station.railway.com remain affected.\n\nWe will continue posting updates at least every 30 minutes, and sooner if we have more information. The next update will be at 20:25 UTC",createdAt:"2026-10-21T19:55:14.593342+00:00"},$R[13836]={id:"7ed3aa64-901b-4701-bf8d-07b483787176",status:"IDENTIFIED",message:"Earlier today an issue affecting multiple systems led us to pause builds across the platform. We are now working to bring builds back.\n\nWe expect builds for Enterprise workspaces to be available by 20:30 UTC. Pro, Hobby, then Free and Trial will follow in stages, and we will post here as each is enabled.\n\nOur API, dashboard and station.railway.com remain affected.\n\nWe will continue posting updates at least every 30 minutes, and sooner if anything changes. The next update will be at 20:00 UTC.",createdAt:"2026-10-21T19:30:14.098189+00:00"},$R[13837]={id:"c60271c0-dc29-4523-9a75-8097121266d6",status:"IDENTIFIED",message:"Builds and deployments remain paused, and our API, dashboard and station.railway.com are still affected.\n\nWhen we re-enable builds, we will do it in stages to keep the platform stable as capacity comes back: Enterprise workspaces first, followed by Pro, then Hobby, then Free and Trial. We will post here as each stage is enabled.\n\nWe will continue posting updates at least every 30 minutes, and sooner if anything changes. The next update will be at 19:45 UTC.",createdAt:"2026-10-21T19:15:08.015611+00:00"},$R[13838]={id:"5072387e-e8d3-48d4-ba0c-37e153693a01",status:"IDENTIFIED",message:"Work on the issues affecting our API, dashboard, and the build and deployment pipeline is ongoing. Builds and deployments remain paused, and station.railway.com is still unavailable. We do not have new information to share at this time.\n\nWe will continue posting updates at least every 30 minutes, and sooner if anything changes. The next update will be at 19:15 UTC.",createdAt:"2026-10-21T18:45:11.132529+00:00"},$R[13839]={id:"99af0509-3df8-4dcf-9fed-6feaf31f4ef8",status:"IDENTIFIED",message:"Builds and deployments remain paused, and our API, dashboard and station.railway.com are still affected. We do not have new information to share at this time.\n\nWe will continue posting updates at least every 30 minutes, and sooner if anything changes. The next update will be at 18:45 UTC.",createdAt:"2026-10-21T18:15:06.799569+00:00"},$R[13840]={id:"6c92cc02-8c2b-4a05-b765-96f643831cbd",status:"IDENTIFIED",message:"There is no change to report. Our API, dashboard, and the build and deployment pipeline remain affected, builds and deployments are still paused, and station.railway.com remains unavailable.\n\nWe will continue posting updates at least every 30 minutes, and sooner if anything changes. The next update will be at 18:15 UTC.",createdAt:"2026-10-21T17:45:11.333765+00:00"},$R[13841]={id:"19926929-d05f-418b-b5bc-949126ce48cb",status:"IDENTIFIED",message:"We are still working to resolve the issues affecting our API, dashboard, and the build and deployment pipeline. Builds and deployments remain paused, and our support site (station.railway.com) is unavailable.\n\n\nWe do not have further detail to share yet. We will post updates at least every 30 minutes, and sooner if we have more information. The next update will be at 17:45 UTC.",createdAt:"2026-10-21T17:18:44.254437+00:00"},$R[13842]={id:"c2198988-797d-4ff9-b83f-633652bf003d",status:"IDENTIFIED",message:"We are still working to resolve the issues affecting our API, dashboard, and the build and deployment pipeline. Builds and deployments remain paused, and our support site (station.railway.com) is also unavailable, so new support requests cannot be submitted there at this time.",createdAt:"2026-10-21T16:29:05.662425+00:00"},$R[13843]={id:"0c8690bb-b6a8-4ace-aee7-73764ad330d6",status:"IDENTIFIED",message:"There is no change since our last update. Builds remain paused and some API features are still unavailable. Our support platform is still down as well. We are continuing to work on a fix and will post updates here.",createdAt:"2026-10-21T13:40:38.705388+00:00"},$R[13844]={id:"036b7389-7813-4fac-99c6-3b30500740ca",status:"IDENTIFIED",message:"Builds remain paused. Our API is back up, but some features remain unavailable.\n\nWe are working on restoring access to our support platform and will continue providing updates here.",createdAt:"2026-10-21T11:33:25.036564+00:00"},$R[13845]={id:"07c7bf49-01e6-4678-9d6c-01aa0ac08305",status:"IDENTIFIED",message:"We have identified the issue and are working on a fix. While we do, the Railway dashboard, API and CLI are unavailable, and new builds remain paused in all regions. Our support site is also affected, so replies to support requests will be delayed.",createdAt:"2026-10-21T09:28:37.423503+00:00"},$R[13846]={id:"22559405-2de6-41eb-9133-c7514cd8843d",status:"INVESTIGATING",message:"We are seeing issues on Railways backend as well. We are still investigating this issue.",createdAt:"2026-10-21T08:28:31.264650+00:00"},$R[13847]={id:"438dceef-96c3-4879-8524-8917ee6af0ba",status:"INVESTIGATING",message:"We are currently investigating this issue",createdAt:"2026-10-21T07:24:24.727677+00:00"}]},$R[13848]={id:"b81f14f9-0c99-492e-abdc-9a8bc1c7e67d",slug:"PX5UYXCN",title:"Builds paused for Free, Trial and Hobby workspaces",status:"RESOLVED",createdAt:"2026-10-21T02:49:46.359069+00:00",resolvedAt:"2026-10-21T02:51:30.987902+00:00",components:$R[13849]=[$R[13850]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"OPERATIONAL"},$R[13851]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"OPERATIONAL"},$R[13852]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"OPERATIONAL"},$R[13853]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"OPERATIONAL"}],updates:$R[13854]=[$R[13855]={id:"bf3f905d-c263-4a5f-b922-575919cd2ca6",status:"RESOLVED",message:"Dismissed as a notice. No impact.",createdAt:"2026-10-21T02:51:30.987902+00:00"},$R[13856]={id:"b136535c-c81e-4204-a0e8-ed22bb0ebe88",status:"TRIAGE",message:"We have temporarily paused builds for workspaces for Free, Trial and Hobby plans. New deployments for these workspaces will stay queued until builds resume. \n\nServices that are already running are not affected. Builds for Pro and Enterprise workspaces are processing normally.",createdAt:"2026-10-21T02:49:46.359069+00:00"}]},$R[13857]={id:"a9a5876a-89b2-440d-9cd9-441af823aacb",slug:"JUA1PC5H",title:"New builds are temporarily paused",status:"RESOLVED",createdAt:"2026-10-20T17:03:41.416651+00:00",resolvedAt:"2026-10-20T20:56:03.245532+00:00",components:$R[13858]=[$R[13859]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"MAJOR_OUTAGE"},$R[13860]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"MAJOR_OUTAGE"},$R[13861]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"MAJOR_OUTAGE"},$R[13862]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"MAJOR_OUTAGE"}],updates:$R[13863]=[$R[13864]={id:"237cab43-3fac-4634-95e4-375efe4d45c9",status:"RESOLVED",message:"Builds have resumed for all workspaces and are completing normally. This incident is now resolved.\n\nIf you triggered a deploy, pushed to GitHub, or restarted a service while builds were paused, please trigger it again. Those were not queued during the pause and will not start on their own. Cron jobs scheduled during the pause did not run, and will continue from their next scheduled time.\n\nWe're sorry for the disruption",createdAt:"2026-10-20T20:56:03.245532+00:00"},$R[13865]={id:"9b47a4ea-7c5d-4289-9395-e8b0e81fe0a0",status:"MONITORING",message:"Builds are now enabled for Hobby workspaces, in addition to Enterprise and Pro. We are working to resume builds for all remaining workspaces next.\n\nDeploys triggered while builds were paused will need to be triggered again once builds are back for your workspace.\n\nWe'll share another update as we resume builds for the remaining workspaces.",createdAt:"2026-10-20T20:43:43.722588+00:00"},$R[13866]={id:"2e7f928d-93f8-468c-8480-d3d3c9bbbd7b",status:"MONITORING",message:"Builds are now enabled for Pro workspaces, in addition to Enterprise. We are working to resume builds for all remaining workspaces next.\n\nDeploys triggered while builds were paused will need to be triggered again once builds are back for your workspace.\n\nWe'll share another update as we resume builds for the remaining workspaces.",createdAt:"2026-10-20T20:20:06.323101+00:00"},$R[13867]={id:"10ac2b05-1ef3-42ad-a36f-61225d0ffa46",status:"IDENTIFIED",message:"We have applied a fix and are gradually resuming builds. Builds are now enabled for Enterprise workspaces, and we are working to resume builds for all other workspaces next.\n\nDeploys triggered while builds were paused will need to be triggered again once builds are back for your workspace.\n\nWe'll share another update as we resume builds for more workspaces.",createdAt:"2026-10-20T19:59:29.513099+00:00"},$R[13868]={id:"35b3595c-8c6e-4fe2-860a-ad709293c421",status:"IDENTIFIED",message:"We are continuing to work on the issue affecting builds. Builds remain paused for all workspaces while we do, and we will bring them back in stages once we're confident everything is working as expected.\n\nDeploys triggered during this period will need to be triggered again once builds resume. Services that are already deployed and running are not affected.\n\nWe'll share another update as soon as builds begin to resume.",createdAt:"2026-10-20T19:10:56.431912+00:00"},$R[13869]={id:"6a45c1bd-47a5-4035-8458-c4c1cff8968f",status:"IDENTIFIED",message:"We have identified the issue affecting builds and are working on a fix. While we do, new builds are now paused for all workspaces. Deploys triggered during this period will need to be triggered again once we resume builds.\n\nServices that are already deployed and running are not affected.\n\nWe will provide further updates as we make progress.",createdAt:"2026-10-20T17:18:53.181035+00:00"},$R[13870]={id:"ec8bd0fb-702e-4c14-8b29-e7f91d2ea228",status:"INVESTIGATING",message:"We are aware of an issue affecting builds and have temporarily paused new builds for most workspaces while we investigate. Deploys triggered during this period will need to be triggered again once we resume builds.\n\nServices that are already deployed and running are not affected.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-10-20T17:03:41.416651+00:00"}]},$R[13871]={id:"59de63c8-2212-4f7b-b9dd-d0911eff3932",slug:"U3RALRQ7",title:"Builds are taking longer than usual",status:"RESOLVED",createdAt:"2026-10-13T16:12:34.344490+00:00",resolvedAt:"2026-10-13T17:00:06.889234+00:00",components:$R[13872]=[$R[13873]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13874]=[$R[13875]={id:"bdaf8f61-178a-4516-9b58-853e9d622123",status:"RESOLVED",message:"The issue affecting build times in US West has been resolved. Build times have returned to normal and the queue has cleared.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-10-13T17:00:06.889234+00:00"},$R[13876]={id:"cd5fef7b-34ba-442b-9303-ddcce123ceea",status:"MONITORING",message:"Build times in US West are returning to normal. We are monitoring the situation and will mark this incident as resolved once we have confirmed sustained recovery.\n\nUsers in other regions are not affected. We will provide a further update shortly.",createdAt:"2026-10-13T16:45:45.381686+00:00"},$R[13877]={id:"2933f2c8-7e62-421d-80d3-356c2c54c3d5",status:"IDENTIFIED",message:"We have identified the root cause of the build slowness in US West and are rolling out a fix. Build times are beginning to improve as the fix is deployed.\n\nUsers in US West may still experience builds taking longer than usual while the fix propagates. Users in other regions are not affected. We will provide a further update once the fix is fully in place.",createdAt:"2026-10-13T16:39:21.306405+00:00"},$R[13878]={id:"ce2f9472-26e8-4cdc-98d6-d200c9814f99",status:"IDENTIFIED",message:"We have identified an issue affecting build infrastructure in US West and are investigating a potential cause. Our team is working on a fix and scaling capacity in the region.\n\nUsers in US West may experience builds taking significantly longer to complete. Users in other regions are not affected. We will provide updates as we learn more.",createdAt:"2026-10-13T16:35:49.851440+00:00"},$R[13879]={id:"1340e3f0-8f8b-4d11-980f-6a778c7097f3",status:"INVESTIGATING",message:"We are aware of an issue causing builds to take longer than usual. Users may experience extended build times.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-10-13T16:12:34.344490+00:00"}]},$R[13880]={id:"3c8efb98-d637-40e3-9e8e-e8941e5a57e7",slug:"31JU4V10",title:"Central Station not loading for some users",status:"RESOLVED",createdAt:"2026-10-10T01:34:56.813655+00:00",resolvedAt:"2026-10-10T01:39:52.002872+00:00",components:$R[13881]=[$R[13882]={id:"d67c1212-cdeb-4476-81ef-34fa605d5e1f",name:"Support & Community — station.railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13883]=[$R[13884]={id:"ebe6ad0c-1ddb-4f5f-8e0e-3125673cbe0c",status:"RESOLVED",message:"This incident has been resolved",createdAt:"2026-10-10T01:39:52.002872+00:00"},$R[13885]={id:"0fe3d446-9f21-4098-b573-a2012bbfc3e0",status:"INVESTIGATING",message:"We're investigating reports of station.railway.com being unavailable",createdAt:"2026-10-10T01:34:56.813655+00:00"}]},$R[13886]={id:"1bae4415-6e04-41bc-812a-31d325f2e66c",slug:"O3D8H5MZ",title:"Builds and deploys failing to pull images from Docker Hub",status:"RESOLVED",createdAt:"2026-10-09T21:29:46.442434+00:00",resolvedAt:"2026-10-09T22:07:19.844355+00:00",components:$R[13887]=[$R[13888]={id:"3488ede3-6856-471a-9e1b-cec742247c1e",name:"Image Registry — Dockerhub",groupName:"External & Third-Party Integrations",impact:"PARTIAL_OUTAGE"}],updates:$R[13889]=[$R[13890]={id:"708120da-baee-4adf-93da-9f625cf5eab1",status:"RESOLVED",message:"The issue affecting image pulls from Docker Hub has been resolved: https://www.dockerstatus.com/incidents/01M4HA1E00AH6NXA276AW0CK2V. Builds and deployments that use Docker Hub images are completing normally.\n\nIf you had a deployment fail during this window, redeploying it should go through.",createdAt:"2026-10-09T22:07:19.844355+00:00"},$R[13891]={id:"4a80640e-43c8-4742-bff8-e1101736d6fc",status:"MONITORING",message:"Docker Hub has resolved the issue on their side and image pulls are succeeding again. Builds and deployments that use Docker Hub images should now complete normally. If a deployment failed during this incident, please redeploy it. We're monitoring to make sure everything stays stable.",createdAt:"2026-10-09T22:03:35.262119+00:00"},$R[13892]={id:"debfb717-5c54-4652-a535-3d160cd5a1ab",status:"IDENTIFIED",message:"We've identified that this is caused by an ongoing incident with Docker Hub, which is causing image pulls to fail. Builds and deployments that use Docker Hub images may fail until this is resolved.\n\nImages from other registries are not affected. You can follow Docker's updates here: https://www.dockerstatus.com/incidents/01M4HA1E00AH6NXA276AW0CK2V\n\nWe're monitoring closely and will share an update as pulls recover.",createdAt:"2026-10-09T21:49:31.687856+00:00"},$R[13893]={id:"f4656f5b-e60d-49d2-bf0b-eeb8f3e99b42",status:"INVESTIGATING",message:"We are aware of an issue affecting builds and deployments that use images from Docker Hub. Affected builds or deploys may fail with a \"429 Too Many Requests\" error when pulling images.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-10-09T21:29:46.442434+00:00"}]},$R[13894]={id:"ab437bce-de82-4d89-ba2d-43edad41ad90",slug:"W5G4XFDQ",title:"Dashboard loading issues",status:"RESOLVED",createdAt:"2026-10-05T15:37:51.287162+00:00",resolvedAt:"2026-10-05T16:12:55.528751+00:00",components:$R[13895]=[$R[13896]={id:"3986bf05-60cf-4555-bb3d-35edcd71b2c2",name:"Dashboard — railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13897]=[$R[13898]={id:"6543e447-8f89-4102-8dc3-3ad73eae8201",status:"RESOLVED",message:"The dashboard loading issues have been resolved. The disruption was caused by API pods experiencing high event loop delays, leading to slow response times and liveness probe failures. We scaled up capacity to restore normal performance.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-10-05T16:12:55.528751+00:00"},$R[13899]={id:"195e555c-3b71-44e7-bef5-9fa5d9d8e76e",status:"MONITORING",message:"We are seeing recovery in dashboard response time and will continue to monitor this incident.\n\nWe will provide updates as recovery completes.",createdAt:"2026-10-05T15:57:50.851378+00:00"},$R[13900]={id:"bdb5ac05-094d-4e3e-ace8-69a5ab360d7e",status:"INVESTIGATING",message:"We are aware of an issue affecting the Railway dashboard. Users may experience slow load times or difficulty accessing the dashboard.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-10-05T15:37:51.287162+00:00"}]},$R[13901]={id:"183cfeee-e840-444c-ae35-61a6f81cb4ca",slug:"8RELVRFI",title:"GitHub-triggered builds are delayed",status:"RESOLVED",createdAt:"2026-10-05T14:55:10.694201+00:00",resolvedAt:"2026-10-05T16:13:29.541385+00:00",components:$R[13902]=[$R[13903]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13904]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13905]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[13906]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"},$R[13907]={id:"781f2691-180a-4ab6-a876-33244a259913",name:"GitHub — Auto-Deploys",groupName:"External & Third-Party Integrations",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13908]=[$R[13909]={id:"15400c4a-aa4c-4fd2-aa82-971339e29425",status:"RESOLVED",message:"The issue affecting GitHub-triggered builds has been resolved. The build queue has fully drained and builds are processing normally across all regions.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-10-05T16:13:29.541385+00:00"},$R[13910]={id:"342396d7-d274-4407-9374-b8b4f4d4c94c",status:"MONITORING",message:"We are seeing recovery and the build queue is continuing to drain. GitHub-triggered builds may still take longer than usual to start while we work through the remaining backlog.\n\nWe will provide another update as we make further progress.",createdAt:"2026-10-05T15:52:56.432162+00:00"},$R[13911]={id:"19400473-5ea8-4cba-863f-d2e55d7e0894",status:"IDENTIFIED",message:"We've identified the issue and are working on a fix.\n\nWe will continue to provide updates as we learn more.",createdAt:"2026-10-05T15:40:50.325468+00:00"},$R[13912]={id:"b9043367-dc0e-4b63-827e-2424828ba18d",status:"INVESTIGATING",message:"We are aware of an issue affecting builds triggered by GitHub. Users may experience builds queuing or taking longer than usual to start.\n\nWe are actively investigating the root cause and will provide updates as we learn more.",createdAt:"2026-10-05T14:55:10.694201+00:00"}]},$R[13913]={id:"d1873242-0a30-4549-904b-5b70b3d9e222",slug:"A0O39CGE",title:"Slow attached storage for some users in US West",status:"RESOLVED",createdAt:"2026-10-04T02:47:47.451481+00:00",resolvedAt:"2026-10-04T06:23:38.196605+00:00",components:$R[13914]=[$R[13915]={id:"9b63a7ce-3e44-412d-ace8-654a9dab6dc7",name:"Storage",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"}],updates:$R[13916]=[$R[13917]={id:"9ea7ffe1-0dcc-4953-ad93-fa41b305775d",status:"RESOLVED",message:"The storage performance issue affecting some users in US West has been resolved. Latency has returned to baseline and storage operations are back to normal levels.\n\nWe apologize for any inconvenience this caused. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-10-04T06:23:38.196605+00:00"},$R[13918]={id:"1225bf51-f31d-4378-9a33-891932aabab2",status:"MONITORING",message:"Storage performance in US West has returned to normal. Latency is back to baseline and write operations have resumed at expected levels.\n\nWe are continuing to monitor to confirm stability. If you are still experiencing issues, please reach out to support at https://station.railway.com.",createdAt:"2026-10-04T06:14:12.455249+00:00"},$R[13919]={id:"ebd2434f-acf9-4819-97fa-f6165a41795a",status:"MONITORING",message:"Storage performance in US West continues to improve. Latency is gradually decreasing as we work through the remaining remediation steps.\n\nWe are actively monitoring and will provide another update once we have more to share.",createdAt:"2026-10-04T06:08:09.340084+00:00"},$R[13920]={id:"49e4b927-8566-44e7-a337-b6d9e7e10c5b",status:"IDENTIFIED",message:"We have identified the cause of the storage performance degradation affecting some users in US West and are actively working to resolve it.\n\nWe will continue to provide updates as we make progress.",createdAt:"2026-10-04T04:50:09.914788+00:00"},$R[13921]={id:"dd51154a-c45a-40ca-9134-6718a4dded61",status:"INVESTIGATING",message:"We are aware of an issue affecting attached storage performance for some users in US West. Users may experience slow services and databases, queries taking longer than expected, deploys that are slow to become healthy, or intermittent crash loops.\n\nWe have identified the cause and are actively working to restore normal performance. We will provide updates as we learn more.",createdAt:"2026-10-04T00:34:47.451+00:00"}]},$R[13922]={id:"db0015bb-b09d-46d2-969b-28c27e3423bb",slug:"72DDHCC1",title:"Services and databases unavailable for some users in US West",status:"RESOLVED",createdAt:"2026-10-03T16:55:13.647495+00:00",resolvedAt:"2026-10-03T19:33:30.056681+00:00",components:$R[13923]=[$R[13924]={id:"62e90e91-bad4-4caa-b948-7585c6a6c3f3",name:"Compute",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"}],updates:$R[13925]=[$R[13926]={id:"488cd907-de51-48e2-8fe1-fc06b499fd29",status:"RESOLVED",message:"The issue affecting services and databases in US West has been resolved.\n\nWe apologize for any disruption. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-10-03T19:33:30.056681+00:00"},$R[13927]={id:"abece16f-d586-4a6b-9a7a-51834880f5e6",status:"MONITORING",message:"All affected hosts in US West have been restarted, and services running on them are recovering. Users with affected services have been notified by email and in-app.\n\nIf one of your services is still unavailable, redeploy it once from your dashboard. If that doesn't resolve it, please reach out at station.railway.com.",createdAt:"2026-10-03T17:21:43.391947+00:00"},$R[13928]={id:"a714a355-f1c5-4b23-8e0c-b99ebda72a9e",status:"IDENTIFIED",message:"We have identified an issue causing some hosts in US West to become unresponsive. Services and databases running on those hosts may be unreachable or fail to connect, and redeploys of affected services may stall.\n\nWe are restarting the affected hosts, and services will come back automatically as each host recovers. Users with affected services will receive an email and an in-app notification. We will provide updates as we learn more.",createdAt:"2026-10-03T11:43:13.647+00:00"}]},$R[13929]={id:"40ff3b6a-0a65-47d3-8f2e-e706ce3b0bbc",slug:"APS57NR6",title:"Potential intermittent connectivity issues",status:"RESOLVED",createdAt:"2026-10-02T16:53:41.001730+00:00",resolvedAt:"2026-10-02T17:17:43.891015+00:00",components:$R[13930]=[$R[13931]={id:"5cdc7232-4592-4485-9e6c-1727853dbcd6",name:"Networking — Public",groupName:"US West (California, USA)",impact:"OPERATIONAL"},$R[13932]={id:"7c64e6e4-5f08-4c90-b337-94f590ff55b5",name:"Networking — Public",groupName:"EU West (Amsterdam, Netherlands)",impact:"OPERATIONAL"},$R[13933]={id:"90ea440b-950e-401f-a13d-00394cb44c66",name:"Networking — Public",groupName:"US East (Virginia, USA)",impact:"OPERATIONAL"},$R[13934]={id:"3dab8031-9369-40bb-b5d5-c87b8bce91eb",name:"Networking — Public",groupName:"Southeast Asia (Singapore)",impact:"OPERATIONAL"}],updates:$R[13935]=[$R[13936]={id:"613d0db2-9c4b-4b37-a19b-aa4710bc20f6",status:"RESOLVED",message:"Dismissed as a notice. No impact.",createdAt:"2026-10-02T17:17:43.891015+00:00"},$R[13937]={id:"e153827a-4abc-4bd3-8d89-c954d12f14ac",status:"TRIAGE",message:"We are aware of intermittent connectivity issues affecting some services hosted. Users may have experienced slower response times or brief connectivity disruptions. We are actively applying network-level mitigations and are monitoring to confirm full recovery. We will provide updates as we learn more.",createdAt:"2026-10-02T16:53:41.001730+00:00"}]},$R[13938]={id:"82b46e4b-d195-4a7e-b63e-086448a1db8b",slug:"P69V3NT0",title:"Slow dashboard and auth timeouts",status:"RESOLVED",createdAt:"2026-09-30T15:06:40.060610+00:00",resolvedAt:"2026-09-30T15:34:30.083792+00:00",components:$R[13939]=[],updates:$R[13940]=[$R[13941]={id:"e86e2611-f1bf-4755-8143-7d35528b472a",status:"RESOLVED",message:"The issue causing dashboard slowness and auth timeouts has been resolved. Error rates have returned to normal levels.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-09-30T15:34:30.083792+00:00"},$R[13942]={id:"da7b113e-6003-4a98-8278-d2a0179578a0",status:"MONITORING",message:"We're seeing recovery and are continuing to monitor this incident.",createdAt:"2026-09-30T15:21:51.114689+00:00"},$R[13943]={id:"16689d9a-499b-495b-9b2a-b8edd5cf493e",status:"INVESTIGATING",message:"We're investigating an issue causing the dashboard to load slower than usual, along with some auth issues causing users to be disconnected.\n\nWe are investigating this incident and will post updates here as we know more.",createdAt:"2026-09-30T15:06:40.060610+00:00"}]},$R[13944]={id:"f2daa9bd-6812-4fde-b8ad-5348a59824d4",slug:"IFBXJTGG",title:"Domain routing disruption",status:"RESOLVED",createdAt:"2026-09-30T07:34:39.721+00:00",resolvedAt:"2026-09-30T07:57:53.005+00:00",components:$R[13945]=[$R[13946]={id:"90ea440b-950e-401f-a13d-00394cb44c66",name:"Networking — Public",groupName:"US East (Virginia, USA)",impact:"MAJOR_OUTAGE"},$R[13947]={id:"5cdc7232-4592-4485-9e6c-1727853dbcd6",name:"Networking — Public",groupName:"US West (California, USA)",impact:"MAJOR_OUTAGE"},$R[13948]={id:"7c64e6e4-5f08-4c90-b337-94f590ff55b5",name:"Networking — Public",groupName:"EU West (Amsterdam, Netherlands)",impact:"MAJOR_OUTAGE"},$R[13949]={id:"3dab8031-9369-40bb-b5d5-c87b8bce91eb",name:"Networking — Public",groupName:"Southeast Asia (Singapore)",impact:"MAJOR_OUTAGE"}],updates:$R[13950]=[$R[13951]={id:"585ae823-bd35-47e8-ad28-fa77cae0b78a",status:"RESOLVED",message:"The global routing service provided a `not-found` response after a rollout of a network config change. The system self healed after the config change led to errors. Unfortunately, this led to observed impact to new connections to Railway hosted workloads for 5 minutes. There is no further and ongoing impact. The Networking team will be working on a full root cause and we will update this status report with a published cause.",createdAt:"2026-09-30T08:17:53.005116+00:00"},$R[13952]={id:"95ca2f69-ac13-4fbf-9d8e-a8c4eb53dc5a",status:"MONITORING",message:"We are aware of an issue that caused domains hosted on Railway to return 404 errors. The issue lasted approximately 5 minutes and has since been mitigated, this is a post facto report. \n\nWe are investigating the root cause and will provide updates as we learn more.",createdAt:"2026-09-30T07:48:39.721111+00:00"}]},$R[13953]={id:"71199b93-2740-4d53-a8d4-e93fad9010c1",slug:"YYTG8I10",title:"API degradation causing slow or stuck deployments",status:"RESOLVED",createdAt:"2026-09-29T15:29:30.391697+00:00",resolvedAt:"2026-09-29T19:15:15.828708+00:00",components:$R[13954]=[$R[13955]={id:"2f6f64ef-7853-45d2-ad5d-ee553211249a",name:"API — backboard.railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"},$R[13956]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13957]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13958]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[13959]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13960]=[$R[13961]={id:"d8e05971-a6a6-4399-a331-b106e2912468",status:"RESOLVED",message:"The issue affecting our API and causing slow or stuck deployments has been resolved. A period of elevated load on our API caused a backlog to build in our deployment queue faster than it could drain. We applied several fixes to improve how our deployment system handles backpressure and temporarily paused new deployments for Hobby-tier projects while the queue recovered. All deployments have since resumed and are processing normally.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-09-29T19:15:15.828708+00:00"},$R[13962]={id:"13c50e5e-d19d-43e0-ae56-bcc71d1c3618",status:"MONITORING",message:"We are seeing recovery and are monitoring this incident.\n\nHobby deployments have been re-enabled.",createdAt:"2026-09-29T18:37:57.901531+00:00"},$R[13963]={id:"87063e03-4af0-45d4-95bd-4759674cd988",status:"INVESTIGATING",message:"We are aware of an issue affecting our API that is causing slow or stuck deployments for some users.\n\nWe are actively investigating and working to restore normal operations. We will provide updates as we learn more.",createdAt:"2026-09-29T15:29:30.391697+00:00"}]},$R[13964]={id:"152b3250-d741-4959-ae17-b088707c8fdd",slug:"K8KROKKW",title:"Builds are slow in EU West",status:"RESOLVED",createdAt:"2026-09-23T13:24:40.122496+00:00",resolvedAt:"2026-09-23T15:13:51.912006+00:00",components:$R[13965]=[$R[13966]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13967]=[$R[13968]={id:"02859caa-4a14-423f-9b7c-6c3ffc8dc3c4",status:"RESOLVED",message:"Build times in EU West (Amsterdam) have returned to normal and the issue has been resolved.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-09-23T15:13:51.912006+00:00"},$R[13969]={id:"81cdae4d-d352-44cf-9a2e-8aec06648a44",status:"MONITORING",message:"We are continuing to monitor the situation following our fix. Build times in EU West (Amsterdam) are returning to normal and the queue is clearing.\n\nWe will provide a further update shortly.",createdAt:"2026-09-23T14:52:09.239444+00:00"},$R[13970]={id:"02a41018-4c87-4ca7-bb01-15b4d121e1fe",status:"IDENTIFIED",message:"We have identified the root cause as an issue with our deployment system in EU West that was causing builds to queue and take longer than expected. We are working to resolve this and will provide another update as we make progress.",createdAt:"2026-09-23T14:13:03.023467+00:00"},$R[13971]={id:"6fad0501-66d2-434a-8100-f99321805dbe",status:"INVESTIGATING",message:"We have identified a possible issue with our deployment system in EU West that may be causing builds to queue and take longer than expected. We are continuing to investigate and working to resolve the issue.\n\nWe will provide another update as we learn more.",createdAt:"2026-09-23T13:53:09.689346+00:00"},$R[13972]={id:"6ebb46cc-2aa4-4397-9aa8-475eb316e49c",status:"INVESTIGATING",message:"We are aware of an issue causing builds to take longer than expected in EU West (Amsterdam). Users in this region may experience builds progressing slowly or taking longer to start.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-09-23T13:24:40.122496+00:00"}]},$R[13973]={id:"8f5ed951-5e00-465c-9554-14dd0ba94da0",slug:"OR0KYYZU",title:"Storage bucket creation is degraded",status:"RESOLVED",createdAt:"2026-08-31T15:31:06.692894+00:00",resolvedAt:"2026-08-31T16:12:54.102767+00:00",components:$R[13974]=[$R[13975]={id:"846bac00-2f00-4fdd-b641-31b5eaf75ce8",name:"Storage Buckets",groupName:"US East (Virginia, USA)",impact:"PARTIAL_OUTAGE"},$R[13976]={id:"8ebd7238-ad06-411a-9a96-11c78d60ca6b",name:"Storage Buckets",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"},$R[13977]={id:"07e9cf1b-3482-43ab-8e2b-7e5acc636da2",name:"Storage Buckets",groupName:"EU West (Amsterdam, Netherlands)",impact:"PARTIAL_OUTAGE"},$R[13978]={id:"b073ad1b-b196-4b29-93e7-1bc33b886784",name:"Storage Buckets",groupName:"Southeast Asia (Singapore)",impact:"PARTIAL_OUTAGE"}],updates:$R[13979]=[$R[13980]={id:"0168affd-c5fe-4449-b135-aa323f5f649a",status:"RESOLVED",message:"The issue affecting storage bucket creation has been resolved. Requests are processing normally again.\n\nWe apologize for any inconvenience this caused. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-08-31T16:12:54.102767+00:00"},$R[13981]={id:"b5444eba-af14-4d2d-a434-e1535ddde9b1",status:"INVESTIGATING",message:"We are aware of an issue affecting the creation of storage buckets and bucket access keys. Users attempting to create new buckets or access keys may experience failures.\n\nWe are actively investigating the root cause and will provide updates as we learn more.",createdAt:"2026-08-31T15:31:06.692894+00:00"}]},$R[13982]={id:"607baf5f-0372-42c3-90a0-57fd533b0cdc",slug:"Z5Y3WO06",title:"Storage and networking issues affecting some services in US West",status:"RESOLVED",createdAt:"2026-08-29T01:38:31.895892+00:00",resolvedAt:"2026-08-29T02:18:11.321260+00:00",components:$R[13983]=[$R[13984]={id:"62e90e91-bad4-4caa-b948-7585c6a6c3f3",name:"Compute",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"},$R[13985]={id:"a22e5c86-a06f-40e4-ab5d-34cc60f9d739",name:"Networking — Private",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"},$R[13986]={id:"8ebd7238-ad06-411a-9a96-11c78d60ca6b",name:"Storage Buckets",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"}],updates:$R[13987]=[$R[13988]={id:"c69b4cc0-8baa-4c0f-91b8-f0a06eef2bc7",status:"RESOLVED",message:"The storage and networking issues affecting some services in US West have been resolved. The hardware fault in our physical infrastructure has been isolated and removed from rotation, and all services have recovered.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-08-29T02:18:11.321260+00:00"},$R[13989]={id:"8e15101b-035a-4dc2-95d0-b9685f77249b",status:"MONITORING",message:"We have identified the root cause of the storage and networking issues affecting some services in US West. A hardware fault in our physical infrastructure caused degraded connectivity to our storage cluster.\n\nWe have isolated the affected hardware, taken it out of rotation, and are seeing recovery. We will continue to monitor and provide updates as services stabilize.",createdAt:"2026-08-29T02:08:52.645691+00:00"},$R[13990]={id:"65765848-32e2-4e29-820d-e7a9070a0344",status:"INVESTIGATING",message:"We have isolated the issue to our storage infrastructure in US West. Affected services may experience problems starting up, slow or unavailable storage, and degraded private network connectivity.\n\nWe are actively working to resolve the storage issue. We will provide updates as we learn more.",createdAt:"2026-08-29T01:45:08.260630+00:00"},$R[13991]={id:"49a002a6-ae7d-4e1b-8b0d-cd30e897ad63",status:"INVESTIGATING",message:"We are aware of an issue affecting some services hosted in our US West region. Users may experience services that are unavailable, stuck restarting, or experiencing slow connectivity.\n\nWe are actively investigating this issue. We will provide updates as we learn more.",createdAt:"2026-08-29T01:38:31.895892+00:00"}]},$R[13992]={id:"f8db13f5-2212-4646-8d9c-5a5ed533e1f8",slug:"8GL2R2U5",title:"Deployments slow to start",status:"RESOLVED",createdAt:"2026-08-28T23:59:04.509777+00:00",resolvedAt:"2026-08-29T03:38:53.496101+00:00",components:$R[13993]=[$R[13994]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13995]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[13996]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[13997]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[13998]=[$R[13999]={id:"5e782d9b-32eb-4972-8f86-35b7ebd3b59a",status:"RESOLVED",message:"Deployment delays have been resolved. Our deployment pipeline has stabilized. The backlog of queued deployments has been cleared, and throughput has fully returned to normal.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-08-29T03:38:53.496101+00:00"},$R[14000]={id:"0ea923ef-417e-4fc7-91d5-617f77e285d1",status:"MONITORING",message:"Deployments are continuing to recover. We have stabilized our deployment pipeline and cleared most of the backlog of queued deployments. Throughput has returned to nominal levels and new deployments are progressing through the queue.\n\nSome delays may still be experienced as the remaining backlog fully clears. We are actively monitoring and will provide a further update shortly.",createdAt:"2026-08-29T03:33:12.066011+00:00"},$R[14001]={id:"214b94c9-c310-4206-87a7-1e7cf86cc942",status:"INVESTIGATING",message:"We continue to work through a backlog of queued deployments. Our deployment workers have stabilized following configuration changes, and throughput is gradually returning to normal levels. Some deployments may still experience delays as the backlog clears.\n\nWe are actively working to reduce the remaining queue. We will provide further updates as we make progress.",createdAt:"2026-08-29T03:05:52.186856+00:00"},$R[14002]={id:"2ec39388-c2b4-4d0d-b548-f576f775803e",status:"INVESTIGATING",message:"We are continuing to investigate an issue with deployment initialization. While we identified and removed an affected host from rotation, some of our deployment workers are experiencing instability as they work through the backlog of queued deployments.\n\nWe are actively working to stabilize the deployment system and clear the backlog. We will provide further updates as we make progress.",createdAt:"2026-08-29T00:37:58.681822+00:00"},$R[14003]={id:"52c13798-66c1-4ce9-b0c5-723492d09d98",status:"MONITORING",message:"We have identified the cause of the delay: a networking issue on a single host in our infrastructure caused a backlog of deployments to queue up. We have removed the affected host from rotation and are scaling additional capacity to work through the backlog.\n\nDeployments are beginning to progress again. We will continue to monitor and provide an update once things have fully returned to normal.",createdAt:"2026-08-29T00:20:02.585411+00:00"},$R[14004]={id:"15bc93a5-2d08-4ed8-b56e-b6a415b8747a",status:"INVESTIGATING",message:"We are aware of an issue causing deployments to take longer than normal to initialize. Users may experience delays when starting new deployments.\n\nWe have identified a potential cause and are actively working to restore normal behavior. We will provide updates as we learn more.",createdAt:"2026-08-28T23:59:04.509777+00:00"}]},$R[14005]={id:"8a0d13e0-a47e-4725-9ec4-dd4f81522958",slug:"DU8F8R4G",title:"Delayed deploys in AMS",status:"RESOLVED",createdAt:"2026-08-20T18:43:48.706422+00:00",resolvedAt:"2026-08-20T18:44:06.185003+00:00",components:$R[14006]=[$R[14007]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14008]=[$R[14009]={id:"6d8434b4-f7e0-4353-b230-f625e2d6666c",status:"RESOLVED",message:"We had an incident where deploys were delayed in AMS for a short period. We are now back to normal deploy times and are watching the situation closely.",createdAt:"2026-08-20T18:44:06.185003+00:00"},$R[14010]={id:"dcfe2da1-c264-4a9d-84ba-1ae8f04d94b6",status:"MONITORING",message:"We had an incident where deploys were delayed in AMS for a short period. We are now back to normal deploy times and are watching the situation closely.",createdAt:"2026-08-20T18:43:48.706422+00:00"}]},$R[14011]={id:"d5ab1910-86e8-4602-8903-341a2ba8c6ce",slug:"VVL3A03V",title:"Deployments are slow",status:"RESOLVED",createdAt:"2026-08-20T15:27:37.480299+00:00",resolvedAt:"2026-08-20T18:20:22.017891+00:00",components:$R[14012]=[$R[14013]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"PARTIAL_OUTAGE"},$R[14014]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"},$R[14015]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"PARTIAL_OUTAGE"},$R[14016]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"PARTIAL_OUTAGE"}],updates:$R[14017]=[$R[14018]={id:"e233d251-3ff8-4da5-80bc-c49455a0d691",status:"RESOLVED",message:"Deployments are operating normally. The backlog of queued deployments has cleared and deployment times have returned to expected levels.\n\nThe root cause was a Google Cloud infrastructure issue beginning around 14:53 UTC that caused elevated errors in our backend services, leading to congestion in our deployment processing pipeline. We temporarily paused new deployments to prevent further backlog buildup while we worked to restore normal operations. The Google Cloud issue has since resolved and our systems have recovered.\n\nWe apologize for the disruption. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-08-20T18:20:22.017891+00:00"},$R[14019]={id:"fa899d61-a19e-45a9-aab7-24ada13e44aa",status:"MONITORING",message:"The deployment pause has been lifted and the backlog of queued deployments is clearing. New deployments are being accepted and processing again, though some delays may persist as the queue continues to drain.\n\nWe are continuing to monitor the situation and will provide further updates.",createdAt:"2026-08-20T17:31:30.951652+00:00"},$R[14020]={id:"ddc5fce4-ab88-4555-b04b-82367e360100",status:"IDENTIFIED",message:"We have identified that a Google Cloud infrastructure issue is contributing to deployment delays. Our backend services experienced elevated internal errors from Google Cloud beginning around 14:53 UTC, which caused our deployment processing pipeline to become congested. We have made adjustments and it is starting to improve but still delayed. We will provide further updates as the situation develops.",createdAt:"2026-08-20T17:29:03.324498+00:00"},$R[14021]={id:"71095ddb-b0cf-4a3e-a2a2-3a278000f4e1",status:"IDENTIFIED",message:"We have identified that a Google Cloud infrastructure issue is contributing to deployment delays. Our backend services experienced elevated internal errors from Google Cloud beginning around 14:53 UTC, which caused our deployment processing pipeline to become congested.\n\nWe are actively working to mitigate the impact and restore normal deployment throughput. As we do this deployments will be temporarily paused at times and slower. We will provide further updates as the situation develops.",createdAt:"2026-08-20T16:15:08.137841+00:00"},$R[14022]={id:"6ab806e0-3763-43e9-aa6e-438952998682",status:"IDENTIFIED",message:"We have identified that a Google Cloud infrastructure issue is contributing to deployment delays. Our backend services experienced elevated internal errors from Google Cloud beginning around 14:53 UTC, which caused our deployment processing pipeline to become congested.\n\nWe are actively working to mitigate the impact and restore normal deployment throughput. We will provide further updates as the situation develops.",createdAt:"2026-08-20T15:56:36.111387+00:00"},$R[14023]={id:"801f3df5-c854-4574-91d3-fdcaed67fde7",status:"INVESTIGATING",message:"We are aware of an issue causing deployments to queue and take longer than usual to progress. Users may experience delays in deployments starting or completing.\n\nWe are actively investigating the root cause and will provide updates as we learn more.",createdAt:"2026-08-20T15:27:37.480299+00:00"}]},$R[14024]={id:"75e2821d-391a-457e-b309-c8c570e68a2e",slug:"YYU63JUO",title:"Deployments are slow to progress and are prone to timeout failure",status:"RESOLVED",createdAt:"2026-08-18T23:19:52.454983+00:00",resolvedAt:"2026-08-19T02:17:35.783485+00:00",components:$R[14025]=[$R[14026]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14027]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14028]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14029]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14030]=[$R[14031]={id:"a96191dd-88ab-491e-a14c-db7f56a84eed",status:"RESOLVED",message:"We have observed recovery of builds and API back to nominal. Builds are progressing for everyone on the platform.",createdAt:"2026-08-19T02:17:35.783485+00:00"},$R[14032]={id:"ec1d09d9-4554-4c0f-9a38-867ae4b46827",status:"MONITORING",message:"Update: we are now seeing recovery of all build queues, however, a second order impact of the build queue is API response times increasing. API performance should restore once the queue is cleared.\n\nTrial/Hobby/Pro/Enterprise builds are all active and resumed.\n\nWe'll monitor the situation and will provide further updates as we learn more.",createdAt:"2026-08-19T01:47:02.931473+00:00"},$R[14033]={id:"082b2e6a-b9f7-416c-b50b-3ba290c60300",status:"IDENTIFIED",message:"We have identified a load issue within our infrastructure affecting the ability for deployments and builds to progress. \n\nWe have restored builds to Pro users, and are working to get to full capacity for all customers. We will continue to provide updates as the situation develops.",createdAt:"2026-08-19T01:16:52.612549+00:00"},$R[14034]={id:"813103d1-ac16-406a-942d-1601d05e1a3d",status:"INVESTIGATING",message:"We are continuing to investigate and are narrowing down the cause of delayed and failing builds. Thank you for your patience.",createdAt:"2026-08-19T01:01:17.656191+00:00"},$R[14035]={id:"2e0c89dd-9f80-429b-933a-2ac53e787bd8",status:"INVESTIGATING",message:"We are continuing to investigate and are narrowing down cause of delayed builds. Thanks for patience.",createdAt:"2026-08-19T01:01:17.314603+00:00"},$R[14036]={id:"8ce808da-7698-45f4-9904-9d87bd358e71",status:"INVESTIGATING",message:"We are continuing to investigate and are narrowing down cause of delayed builds. Thanks for patience.",createdAt:"2026-08-19T00:40:48.954859+00:00"},$R[14037]={id:"4dac3fd2-ab9e-4c86-91c3-8ff33702abe0",status:"INVESTIGATING",message:"We are aware of an issue causing deployments to remain in an initializing state longer than expected. Users may experience delays in new deployments progressing.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-08-18T23:19:52.454983+00:00"}]},$R[14038]={id:"3d369396-42cc-44c0-8d57-bcba4e42ebcf",slug:"7M7CBL9X",title:"Deployments are slow to progress",status:"RESOLVED",createdAt:"2026-08-18T21:45:01.650906+00:00",resolvedAt:"2026-08-18T22:40:32.803856+00:00",components:$R[14039]=[$R[14040]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14041]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14042]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14043]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14044]=[$R[14045]={id:"d536b82a-ab22-4b9e-8918-44fd1186a1bb",status:"RESOLVED",message:"We have fixed the issue causing deployments to slow and they have returned to normal.",createdAt:"2026-08-18T22:40:32.803856+00:00"},$R[14046]={id:"6ccab297-9d88-43c1-bade-fdd49ef7bf72",status:"MONITORING",message:"We have identified the root cause as an issue with our task queue processing, which is causing builds and deployments to progress more slowly than usual. A revert is currently in progress.\n\nUsers may continue to experience delays in deployments progressing. We will provide another update once the fix is deployed.",createdAt:"2026-08-18T22:17:24.756179+00:00"},$R[14047]={id:"4f4bf355-634e-4717-946e-66458ff8fab9",status:"INVESTIGATING",message:"We are aware of an issue causing deployments to remain in an initializing state longer than expected. Users may experience delays in new deployments progressing.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-08-18T21:45:01.650906+00:00"}]},$R[14048]={id:"9ff97bd5-8299-4fc2-bc6f-e99f608f6ca8",slug:"M2WMOGK3",title:"Deployments queued longer than usual",status:"RESOLVED",createdAt:"2026-08-17T19:50:23.447747+00:00",resolvedAt:"2026-08-17T21:52:34.782607+00:00",components:$R[14049]=[$R[14050]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14051]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14052]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14053]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14054]=[$R[14055]={id:"a3e679fc-1d23-4c2d-84df-63c11511ad4e",status:"RESOLVED",message:"The issue causing deployments to remain queued longer than usual has been resolved. Deployment times are returning to normal across all regions.\n\nWe apologize for any inconvenience. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-08-17T21:52:34.782607+00:00"},$R[14056]={id:"c574d1ad-eb30-43ab-9515-c1f149031542",status:"MONITORING",message:"We have deployed a fix for delayed deployments and they are improving. We are monitoring closely.",createdAt:"2026-08-17T21:25:08.672940+00:00"},$R[14057]={id:"87306b22-50f5-431f-91b6-86ec18b35080",status:"INVESTIGATING",message:"We are aware of an issue causing deployments to remain in a queued state longer than usual. Users may experience delays before their deployments begin.\n\nWe are actively investigating the root cause and will provide updates as we learn more.",createdAt:"2026-08-17T19:50:23.447747+00:00"}]},$R[14058]={id:"ae9fcc3d-8293-4539-a15b-dbf5ec8d0751",slug:"W4MIGEVT",title:"GitHub is experiencing elevated error rates",status:"RESOLVED",createdAt:"2026-08-17T13:59:36.308022+00:00",resolvedAt:"2026-08-17T21:29:19.852591+00:00",components:$R[14059]=[$R[14060]={id:"781f2691-180a-4ab6-a876-33244a259913",name:"GitHub — Auto-Deploys",groupName:"External & Third-Party Integrations",impact:"PARTIAL_OUTAGE"}],updates:$R[14061]=[$R[14062]={id:"e475159f-6fed-4a13-a980-240517fdb27d",status:"RESOLVED",message:"GitHub is reporting that they're fully operational again.",createdAt:"2026-08-17T21:29:19.852591+00:00"},$R[14063]={id:"c10529a4-4aa1-4ac6-b6c6-140c36128dc7",status:"MONITORING",message:"GitHub has seen slight recovery and is monitoring results before resolving.",createdAt:"2026-08-17T19:52:54.317391+00:00"},$R[14064]={id:"0db60a9a-c151-492f-8854-2eec1675a298",status:"IDENTIFIED",message:"GitHub has identified the issue and is working on a fix.",createdAt:"2026-08-17T16:46:57.547437+00:00"},$R[14065]={id:"67780314-bd55-453b-ab3c-5dd3f8d639cb",status:"INVESTIGATING",message:"Automatic deployments, pr environments, and anything relating to GitHub may be heavily delayed or fail. \n\nThey are currently investigating this issue. https://www.githubstatus.com/incidents/zkxwbgr0cnmx",createdAt:"2026-08-17T13:59:36.308022+00:00"}]},$R[14066]={id:"13ffccc0-ff8a-4654-abcc-08555a2da21b",slug:"4R20FOKZ",title:"Logs and Metrics Delays",status:"RESOLVED",createdAt:"2026-08-14T16:05:49.172989+00:00",resolvedAt:"2026-08-14T16:22:51.440428+00:00",components:$R[14067]=[$R[14068]={id:"75c763da-6e95-4025-a6de-00255bbe7028",name:"Logs",groupName:"Observability",impact:"DEGRADED_PERFORMANCE"},$R[14069]={id:"3a438799-8199-47a4-920b-93ecbdf8af75",name:"Metrics",groupName:"Observability",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14070]=[$R[14071]={id:"036bb206-cfa2-47a1-a5fa-2804f3042de7",status:"RESOLVED",message:"We have seen consistent full recovery. \n\nThis incident is now resolved",createdAt:"2026-08-14T16:22:51.440428+00:00"},$R[14072]={id:"dacac996-991e-4894-af83-41aabe820872",status:"MONITORING",message:"We have implemented a fix and have seen full recovery.\n\nWe are monitoring the results",createdAt:"2026-08-14T16:16:54.478661+00:00"},$R[14073]={id:"1407236b-d780-41b8-a995-3b99640433c9",status:"IDENTIFIED",message:"We have identified the issue and are working on a fix.",createdAt:"2026-08-14T16:08:31.443527+00:00"},$R[14074]={id:"05431527-cefd-4b82-80e9-77b5043eb927",status:"INVESTIGATING",message:"We are aware of an issue affecting logs and metrics. Users may experience delays or gaps in log and metric delivery.\n\nWe are actively investigating and will provide updates as we learn more.",createdAt:"2026-08-14T16:05:49.172989+00:00"}]},$R[14075]={id:"8caad6d8-7ce3-460a-a31d-fee2d49dc805",slug:"RZNJOBXD",title:"Railpack builds may be delayed",status:"RESOLVED",createdAt:"2026-08-11T18:52:17.819610+00:00",resolvedAt:"2026-08-11T20:14:51.010093+00:00",components:$R[14076]=[$R[14077]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14078]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14079]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"},$R[14080]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14081]=[$R[14082]={id:"45ccd315-caa2-4f7f-9ddf-795d6ae021cf",status:"RESOLVED",message:"We have seen full recovery and have marked this incident as resolved. \n\nIf you encounter any issues, please open a thread at https://station.railway.com",createdAt:"2026-08-11T20:14:51.010093+00:00"},$R[14083]={id:"20ceed73-7bc9-4d15-ae43-186d8b6b4c00",status:"MONITORING",message:"We have rolled out a fix and are seeing recovery.",createdAt:"2026-08-11T19:47:57.170757+00:00"},$R[14084]={id:"1e3544ff-586f-4cea-b736-54c82020b8f2",status:"IDENTIFIED",message:"We are continuing to work on a fix for this incident.",createdAt:"2026-08-11T19:24:08.932782+00:00"},$R[14085]={id:"1d2153d8-2651-4c38-a8be-8d5f33a533af",status:"IDENTIFIED",message:"We have identified this issue as isolated to users deploying via railway up with railpack. We are working on a fix for this incident.",createdAt:"2026-08-11T18:55:10.876684+00:00"},$R[14086]={id:"6a7af912-1dd9-4dd9-b4d4-c6e7aa946901",status:"INVESTIGATING",message:"We are aware that some select services built using Railpack might have extended build times or fail. We are investigating this incident",createdAt:"2026-08-11T18:52:17.819610+00:00"}]},$R[14087]={id:"c52cc5a4-3c9c-4be2-8712-4509afa92f6a",slug:"RL8FRJE6",title:"Connectivity issues in US West",status:"RESOLVED",createdAt:"2026-08-10T03:39:58.373641+00:00",resolvedAt:"2026-08-10T05:47:35.309247+00:00",components:$R[14088]=[$R[14089]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"},$R[14090]={id:"5cdc7232-4592-4485-9e6c-1727853dbcd6",name:"Networking — Public",groupName:"US West (California, USA)",impact:"PARTIAL_OUTAGE"}],updates:$R[14091]=[$R[14092]={id:"59d04402-0050-42ec-bea5-2cef91cc398f",status:"RESOLVED",message:"This incident has been resolved. Services in US West (California) have returned to normal operation.\n\nA small number of services may need a redeploy to fully recover. If yours is still not behaving as expected, please reach out at https://station.railway.com and we will take a look.\n\nWe apologize for the disruption.",createdAt:"2026-08-10T05:47:35.309247+00:00"},$R[14093]={id:"8ca83550-4ed6-45d8-884e-11d1c967068a",status:"MONITORING",message:"Services in US West (California) are recovering\n\nWe are monitoring the region to confirm it remains stable. If you are still seeing issues with a service in this region, please reach out at https://station.railway.com.",createdAt:"2026-08-10T04:37:10.540958+00:00"},$R[14094]={id:"d69e2e73-02ec-425a-ba89-9e515d2f5e84",status:"IDENTIFIED",message:"We have identified the cause. Elevated traffic into our US West (California) region saturated network capacity, which caused services in the region to become slow or unreachable.\n\nNetwork capacity has recovered and we are seeing affected services return to normal. Some services in the region may still be recovering.\n\nWe will provide another update shortly.",createdAt:"2026-08-10T04:27:46.615275+00:00"},$R[14095]={id:"e11b6907-63a7-4747-b98c-4b17af6c33c6",status:"INVESTIGATING",message:"We are continuing to work on the issues affecting services in US West (California). Some services in the region remain affected: databases may be unreachable, and new deployments may fail or stall\n\nWe will provide another update as we have more.",createdAt:"2026-08-10T04:21:50.453466+00:00"},$R[14096]={id:"74965c81-0f7f-4889-bac2-7b2d2162784a",status:"INVESTIGATING",message:"We are aware of issues affecting services in our US West (California) region. Users may experience intermittent connectivity to deployed services and delays with new deployments in this region.\n\nWe are actively investigating and we will provide updates as we learn more.",createdAt:"2026-08-10T03:39:58.373641+00:00"}]},$R[14097]={id:"6ceddfcb-4070-4d3f-b6c2-8bdad29206f7",slug:"LJT4X01X",title:"Dashboard slowness",status:"RESOLVED",createdAt:"2026-07-31T11:08:39.572908+00:00",resolvedAt:"2026-07-31T11:39:29.630188+00:00",components:$R[14098]=[$R[14099]={id:"3986bf05-60cf-4555-bb3d-35edcd71b2c2",name:"Dashboard — railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"},$R[14100]={id:"2f6f64ef-7853-45d2-ad5d-ee553211249a",name:"API — backboard.railway.com",groupName:"Railway",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14101]=[$R[14102]={id:"68f1c354-49a5-4a16-a700-4fdd81b37f77",status:"RESOLVED",message:"This incident has been resolved.",createdAt:"2026-07-31T11:39:29.630188+00:00"},$R[14103]={id:"75d72415-a743-42e1-98c4-537298b05ffb",status:"MONITORING",message:"We have rolled out a fix and are seeing recovery. We are continuing to monitor this incident.",createdAt:"2026-07-31T11:34:41.142356+00:00"},$R[14104]={id:"398f09cb-8092-406d-a9b3-12b88c2e0c4c",status:"IDENTIFIED",message:"We have identified the issue and are rolling out a fix.",createdAt:"2026-07-31T11:26:17.082618+00:00"},$R[14105]={id:"cfce4060-6ca2-4c8c-a503-7eaa33d7ffbc",status:"INVESTIGATING",message:"Triage escalated to incident",createdAt:"2026-07-31T11:09:32.135636+00:00"},$R[14106]={id:"80ee3071-a416-4198-a809-8e118cfedc64",status:"TRIAGE",message:"We're investigating reports of slowness with the railway.com dashboard",createdAt:"2026-07-31T11:08:39.572908+00:00"}]},$R[14107]={id:"c11563af-ca04-4d5c-ba51-79a146ada382",slug:"OA5Z6SQY",title:"Builds and deployments are delayed",status:"RESOLVED",createdAt:"2026-07-30T16:32:04.607759+00:00",resolvedAt:"2026-07-30T17:59:41.025753+00:00",components:$R[14108]=[$R[14109]={id:"a83c1eb5-855a-46c3-af2c-da91887cffb9",name:"Builds",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14110]={id:"855ae123-f205-4228-89b9-7f38d1912f4b",name:"Deployments",groupName:"US East (Virginia, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14111]={id:"69b44a29-f7ea-4f65-875e-87496c4de392",name:"Builds",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14112]={id:"2d3d5456-51aa-4ab8-a83a-7e5273a58c2f",name:"Deployments",groupName:"US West (California, USA)",impact:"DEGRADED_PERFORMANCE"},$R[14113]={id:"ccee9c8c-69ff-4dc2-8638-6a64bcffc7fc",name:"Builds",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14114]={id:"7fcef7e9-ca32-41c2-ba6e-181691976a2d",name:"Deployments",groupName:"EU West (Amsterdam, Netherlands)",impact:"DEGRADED_PERFORMANCE"},$R[14115]={id:"bd296c88-3ed3-4b2a-8889-7410aac865e1",name:"Builds",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"},$R[14116]={id:"5aaa8735-8c33-4cc8-b517-abafb707c225",name:"Deployments",groupName:"Southeast Asia (Singapore)",impact:"DEGRADED_PERFORMANCE"}],updates:$R[14117]=[$R[14118]={id:"68c21c44-261b-4d37-b15e-4c2ed0b7fd53",status:"RESOLVED",message:"Build and deployment processing has been restored across all regions. All plan tiers are processing normally and the backlog has cleared.\n\nWe apologize for any inconvenience this caused. If you continue to experience issues, please contact support at https://station.railway.com.",createdAt:"2026-07-30T17:59:41.025753+00:00"},$R[14119]={id:"c79c40df-d2ad-4360-957c-f941c2d24ab5",status:"MONITORING",message:"Build and deployment processing has fully resumed. Non-Pro plan deployments have been re-enabled and the Pro plan backlog has cleared.\n\nWe are monitoring the situation to ensure processing remains stable and will provide another update shortly.",createdAt:"2026-07-30T17:47:48.860079+00:00"},$R[14120]={id:"89bc3fde-a364-4d61-a0b6-df44b3d3a04c",status:"IDENTIFIED",message:"We are seeing improvement in build and deployment processing. Hobby plan deployments are no longer queued; Pro plan deployments are still working through a backlog but are trending in the right direction.\n\nWe are continuing to monitor the situation and will provide another update shortly.",createdAt:"2026-07-30T17:43:45.289055+00:00"},$R[14121]={id:"dab35305-1c91-40ae-bebe-f79ca2979e79",status:"IDENTIFIED",message:"We have identified the root cause of the build and deployment delays. We are working to resolve this as soon as possible.\n\nIn the meantime, we have paused new deployments for Hobby and Trial plans to reduce load while we continue to investigate and implement a fix. Pro projects remain active but may continue to experience delays.\n\nWe will provide another update shortly.",createdAt:"2026-07-30T17:10:53.366147+00:00"},$R[14122]={id:"c971748a-1e61-4dfa-927b-11da85d6b4ed",status:"INVESTIGATING",message:"We are aware of an issue causing builds and deployments to be delayed. Hobby and Pro projects are affected. Deployments may take longer to queue and start than usual.\n\nWe are actively investigating and working to restore normal processing times. We will provide updates as we learn more.",createdAt:"2026-07-30T16:32:04.607759+00:00"}]}],maintenances:$R[14123]=[],generatedAt:"2026-10-27T09:47:19.672Z"},ssr:!0}],lastMatchId:"␀␀"})($R["tsr"]);$_TSR.e();document.currentScript.remove()</script><script type="module" async="">import("/assets/main-B0MnktY7.js")</script></body></html>